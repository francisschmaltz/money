<%- include("partials/head", { pageTitle }) %>
<body data-page="portfolio">
  <%- include("partials/site-header", { activePath, viewer }) %>
  <%
    const livePortfolio = typeof portfolioData !== "undefined" ? portfolioData : null;
    const requestedScope =
      typeof portfolioScope !== "undefined"
        ? portfolioScope
        : livePortfolio?.scope ||
          ({ include: "all", exclude: "trading", only: "retirement" }[
            livePortfolio?.retirement_scope
          ] || (query.scope === "taxable" ? "trading" : query.scope) || "all");
    const selectedScope =
      ["all", "trading", "retirement"].includes(requestedScope)
        ? requestedScope
        : "all";
    const portfolioScopeLabels = {
      all: "All investments",
      trading: "Trading investments",
      retirement: "Retirement investments",
    };
    const portfolioLabels = livePortfolio
      ? livePortfolio.series.map((point) => point.timestamp.slice(0, 10))
      : ["Jul 1", "Jul 6", "Jul 11", "Jul 16", "Jul 21", "Jul 26"];
    const portfolioValues = livePortfolio
      ? livePortfolio.series.map((point) => point.value.amount_minor)
      : [0.973, 0.978, 0.98, 0.979, 0.991, 1].map((ratio) =>
          Math.round(overview.portfolio.amount_minor * ratio),
        );
    const sinceTrackingMinor = livePortfolio && livePortfolio.series.length > 1
      ? livePortfolio.series.at(-1).value.amount_minor - livePortfolio.series[0].value.amount_minor
      : livePortfolio ? null : 842100;
    const portfolioCurrency = overview.portfolio.currency || "USD";
    const displayedPortfolioValue =
      livePortfolio?.total_value || overview.portfolio;
    const estimatedReturn = livePortfolio?.estimated_return_basis_points;
    const externalCashFlow = livePortfolio?.external_cash_flow;
    const selectedPeriod = livePortfolio?.period?.name || query.period || "1m";
    const futureEquity = livePortfolio?.future_equity || null;
    const activeHolding =
      typeof selectedHolding !== "undefined" ? selectedHolding : null;
  %>
  <main class="page-shell">
    <%- include("partials/page-heading", {
      eyebrow: freshness,
      pageTitle,
      actionLabel: "Investment insights",
      actionHref: "/insights#investments",
      actionIcon: "ph-sparkle"
    }) %>

    <nav class="portfolio-scope-tabs" aria-label="Investment account scope">
      <% [["all", "All"], ["trading", "Trading"], ["retirement", "Retirement"]].forEach(([scope, label]) => { %>
        <a href="/portfolio?period=<%= selectedPeriod %>&amp;scope=<%= scope %>" aria-current="<%= selectedScope === scope ? 'page' : 'false' %>"><%= label %></a>
      <% }) %>
    </nav>

    <section class="portfolio-grid">
      <article class="card portfolio-hero">
        <div class="card-heading">
          <div>
            <p class="card-kicker"><%= portfolioScopeLabels[selectedScope] %></p>
            <h2 class="display-money"><%= formatMoney(displayedPortfolioValue) %></h2>
            <% if (estimatedReturn != null && livePortfolio?.estimated_gain) { %>
              <p class="trend <%= livePortfolio.estimated_gain.amount_minor >= 0 ? 'trend--positive' : 'trend--negative' %>">
                <i class="ph <%= livePortfolio.estimated_gain.amount_minor >= 0 ? 'ph-arrow-up-right' : 'ph-arrow-down-right' %>"></i>
                <%= formatMoney(livePortfolio.estimated_gain, { sign: true }) %> estimated performance
              </p>
            <% } else if (livePortfolio) { %>
              <p class="trend">Estimated performance waits for complete snapshot and cash-flow history.</p>
            <% } else { %>
              <p class="trend trend--positive"><i class="ph ph-arrow-up-right"></i>+$2,191 estimated performance this month</p>
            <% } %>
          </div>
          <nav
            class="period-select period-select--portfolio"
            aria-label="Portfolio timeframe"
          >
            <% [["1w", "1W"], ["1m", "1M"], ["1y", "1Y"], ["all", "All"]].forEach(([value, label]) => { %>
              <a href="/portfolio?period=<%= value %>&amp;scope=<%= selectedScope %>" aria-current="<%= selectedPeriod === value ? 'true' : 'false' %>"><%= label %></a>
            <% }) %>
          </nav>
        </div>
        <div class="chart-frame chart-frame--portfolio">
          <canvas
            data-chart="line"
            data-labels="<%= JSON.stringify(portfolioLabels) %>"
            data-values="<%= JSON.stringify(portfolioValues) %>"
            data-color="#2664ae"
            aria-label="Portfolio value during the selected period"
            role="img"
          ></canvas>
        </div>
        <div class="split-metrics split-metrics--three">
          <div><span>Estimated return</span><strong><%= estimatedReturn == null ? "—" : `${estimatedReturn >= 0 ? "+" : ""}${(estimatedReturn / 100).toFixed(1)}%` %></strong></div>
          <div><span>Net external cash flow</span><strong><%= externalCashFlow ? formatMoney(externalCashFlow, { sign: true }) : "—" %></strong></div>
          <div><span>Since tracking began</span><strong class="<%= sinceTrackingMinor == null ? '' : sinceTrackingMinor >= 0 ? 'money-positive' : 'money-negative' %>"><%= sinceTrackingMinor == null ? "—" : formatMoney({ amount_minor: sinceTrackingMinor, currency: portfolioCurrency }, { sign: true }) %></strong></div>
        </div>
      </article>

      <article class="card allocation-card">
        <div class="card-heading">
          <div><p class="card-kicker"><%= portfolioScopeLabels[selectedScope] %></p><h2>Allocation</h2></div>
        </div>
        <div class="allocation-chart">
          <canvas
            data-chart="doughnut"
            data-labels="<%= JSON.stringify(allocation.map((item) => item.label)) %>"
            data-values="<%= JSON.stringify(allocation.map((item) => item.value)) %>"
            aria-label="Portfolio allocation by holding"
            role="img"
          ></canvas>
          <div class="allocation-chart__center"><strong><%= allocation.length %></strong><span>holdings</span></div>
        </div>
        <div class="allocation-legend">
          <% allocation.slice(0, 5).forEach((item, index) => { %>
            <span><i></i><%= item.label %><strong><%= item.value %>%</strong></span>
          <% }) %>
        </div>
      </article>
    </section>

    <% if (futureEquity?.total_value?.amount_minor > 0) { %>
      <section class="card future-equity-card" aria-labelledby="future-equity-heading">
        <div class="card-heading future-equity-card__heading">
          <div>
            <p class="card-kicker">Not yet vested</p>
            <h2 id="future-equity-heading">Future equity</h2>
          </div>
          <strong class="display-money"><%= formatMoney(futureEquity.total_value) %></strong>
        </div>
        <div class="future-equity-list" role="list" aria-label="Unvested equity holdings">
          <% futureEquity.holdings.forEach((holding) => { %>
            <div class="future-equity-row" role="listitem">
              <span class="future-equity-row__identity">
                <b class="ticker"><%= (holding.ticker_symbol || holding.name).slice(0, 4) %></b>
                <span>
                  <strong><%= holding.ticker_symbol || holding.name %></strong>
                  <small><%= holding.name %><%= holding.account_name ? ` · ${holding.account_name}` : "" %></small>
                </span>
              </span>
              <span>
                <small>Unvested shares</small>
                <strong>
                  <%= holding.unvested_quantity == null
                    ? "Provider-reported"
                    : holding.unvested_quantity.toLocaleString("en-US", { maximumFractionDigits: 10 }) %>
                </strong>
              </span>
              <span>
                <small>Estimated share price</small>
                <strong><%= holding.estimated_share_price ? formatMoney(holding.estimated_share_price) : "—" %></strong>
              </span>
              <span>
                <small>Current-price value</small>
                <strong><%= formatMoney(holding.value) %></strong>
              </span>
            </div>
          <% }) %>
        </div>
        <p class="card-note"><i class="ph ph-info"></i> Estimated at the provider’s reported price. Not included in current portfolio value.</p>
      </section>
    <% } %>

    <section class="card holdings-card" aria-labelledby="portfolio-holdings-heading">
      <div class="card-heading">
        <div><p class="card-kicker"><%= portfolioScopeLabels[selectedScope] %></p><h2 id="portfolio-holdings-heading">Holdings</h2></div>
        <a class="quiet-link" href="/accounts">Investment accounts <i class="ph ph-arrow-right"></i></a>
      </div>
      <div class="holdings-table">
        <div class="holdings-row holdings-row--header" aria-hidden="true">
          <span>Holding</span><span>Value</span><span>Allocation</span>
        </div>
        <% holdings.forEach((holding) => { %>
          <a
            class="holdings-row"
            href="/portfolio?period=<%= selectedPeriod %>&amp;scope=<%= selectedScope %>&amp;holding=<%= encodeURIComponent(holding.selectionKey || holding.symbol) %>"
            data-detail-dialog-link
            aria-current="<%= activeHolding && (activeHolding.selectionKey || activeHolding.symbol) === (holding.selectionKey || holding.symbol) ? "true" : "false" %>"
          >
            <span><b class="ticker"><%= holding.badge || holding.symbol.slice(0, 4) %></b><span><strong><%= holding.symbol %></strong><small><%= holding.name %></small></span></span>
            <strong><%= formatMoney(holding.value) %></strong>
            <span><%= holding.allocation %>%</span>
          </a>
        <% }) %>
        <% if (!holdings.length) { %>
          <p class="card-note"><i class="ph ph-chart-line-up"></i> No investment holdings have synced yet.</p>
        <% } %>
      </div>
      <p class="card-note"><i class="ph ph-info"></i> <%= livePortfolio?.warnings?.[0] || "Performance is estimated from local snapshots and excludes external cash flows when complete." %></p>
    </section>

    <% if (activeHolding) { %>
      <dialog
        class="entity-detail-dialog"
        data-detail-dialog
        data-detail-auto-open
        data-detail-query-key="holding"
        aria-labelledby="selected-holding-heading"
      >
        <div class="entity-detail-dialog__panel">
          <section class="selected-detail entity-detail-dialog__summary">
            <b class="ticker"><%= selectedHolding.badge || selectedHolding.symbol.slice(0, 4) %></b>
            <div>
              <p class="card-kicker"><%= selectedHolding.isCash ? "Cash balance" : selectedHolding.isAggregated ? "Combined holding" : "Holding details" %></p>
              <h2 id="selected-holding-heading"><%= selectedHolding.symbol %></h2>
              <p><%= selectedHolding.name %></p>
            </div>
            <strong><%= formatMoney(selectedHolding.value) %></strong>
            <button class="icon-button" type="button" data-detail-dialog-close aria-label="Close holding details"><i class="ph ph-x" aria-hidden="true"></i></button>
          </section>

          <div class="entity-detail-dialog__body">
            <% if (selectedHolding.isCash && selectedHolding.positions?.length) { %>
              <section class="holding-position-breakdown" aria-labelledby="holding-position-breakdown-heading">
                <h3 id="holding-position-breakdown-heading">By investment account</h3>
                <div class="holding-position-list" role="list">
                  <% selectedHolding.positions.forEach((position) => { %>
                    <div class="holding-position-row" role="listitem">
                      <span><%= position.account %></span>
                      <strong><%= formatMoney(position.value) %></strong>
                    </div>
                  <% }) %>
                </div>
              </section>
              <p class="entity-detail-dialog__note"><i class="ph ph-info" aria-hidden="true"></i> Cash balances come from the latest synced investment holdings and may be delayed.</p>
            <% } else { %>
              <% if (selectedHolding.isAggregated && selectedHolding.positions?.length) { %>
                <section class="holding-position-breakdown" aria-labelledby="holding-position-breakdown-heading">
                  <h3 id="holding-position-breakdown-heading">By investment account</h3>
                  <div class="holding-position-list" role="list">
                    <% selectedHolding.positions.forEach((position) => { %>
                      <div class="holding-position-row" role="listitem">
                        <span>
                          <%= position.account %>
                          <% if (position.shares != null) { %><small><%= position.shares %> shares</small><% } %>
                        </span>
                        <strong><%= formatMoney(position.value) %></strong>
                      </div>
                    <% }) %>
                  </div>
                </section>
              <% } %>
              <dl class="entity-detail-grid">
                <% if (!selectedHolding.isAggregated) { %>
                  <div><dt>Account</dt><dd><%= selectedHolding.account || "—" %></dd></div>
                <% } %>
                <div><dt>Security type</dt><dd><%= selectedHolding.securityType || "—" %></dd></div>
                <div><dt>Shares</dt><dd><%= selectedHolding.shares ?? "—" %></dd></div>
                <div><dt>Allocation</dt><dd><%= selectedHolding.allocation %>% of <%= portfolioScopeLabels[selectedScope].toLowerCase() %></dd></div>
                <div><dt>Current price</dt><dd><%= selectedHolding.price ? formatMoney(selectedHolding.price) : "—" %></dd></div>
                <div><dt>Price as of</dt><dd><%= selectedHolding.priceAsOf || "—" %></dd></div>
                <div><dt>Cost basis</dt><dd><%= selectedHolding.costBasis ? formatMoney(selectedHolding.costBasis) : "—" %></dd></div>
                <div><dt>Current value</dt><dd><%= formatMoney(selectedHolding.value) %></dd></div>
                <% if (!selectedHolding.isAggregated) { %>
                  <div class="entity-detail-grid__wide"><dt>Holding ID</dt><dd><code><%= selectedHolding.id || "—" %></code></dd></div>
                  <div class="entity-detail-grid__wide"><dt>Security ID</dt><dd><code><%= selectedHolding.securityId || "—" %></code></dd></div>
                <% } %>
              </dl>
              <p class="entity-detail-dialog__note"><i class="ph ph-info" aria-hidden="true"></i> Values come from the latest synced holding<%= selectedHolding.isAggregated ? "s" : "" %> and may be delayed.</p>
            <% } %>
          </div>
        </div>
      </dialog>
    <% } %>
  </main>
  <%- include("partials/footer") %>
