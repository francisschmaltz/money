<%- include("partials/head", { pageTitle }) %>
<body data-page="accounts">
  <%- include("partials/site-header", { activePath, viewer }) %>
  <%
    const nonUsdAccountCount = accounts.filter(
      (account) => account.balance && account.balance.currency !== "USD",
    ).length;
    const accountGroupLabels = {
      cash: "Cash account",
      taxable_investment: "Personal brokerage",
      retirement: "Retirement",
      credit_card: "Credit card",
      loan: "Loan",
      other_asset: "Other asset",
      other_liability: "Other liability",
      excluded: "Excluded",
    };
    const accountManualAssets =
      typeof manualAssets !== "undefined" ? manualAssets : [];
    const manualAssetType = (asset) =>
      asset.assetType || asset.asset_type || asset.type || "other";
  %>
  <main class="page-shell">
    <%- include("partials/page-heading", {
      eyebrow: freshness,
      pageTitle,
      actionLabel: viewer?.is_admin ? "Connect account" : null,
      actionHref: "/settings#connections",
      actionIcon: "ph-plus"
    }) %>

    <section class="account-totals account-totals--wealth" aria-label="Wealth totals">
      <article class="card">
        <span>Cash balance</span>
        <strong><%= formatMoney(overview.cashBalance) %></strong>
        <small>Cash + personal brokerage</small>
      </article>
      <article class="card">
        <span>Short-term worth</span>
        <strong><%= formatMoney(overview.shortTermWorth) %></strong>
        <small>Cash balance − credit-card debt</small>
      </article>
      <article class="card">
        <span>Net worth</span>
        <strong><%= formatMoney(overview.netWorth) %></strong>
        <small>Every included account and manual asset</small>
      </article>
    </section>
    <div class="wealth-breakdown" aria-label="Investment totals">
      <a href="/portfolio?scope=trading">
        <span>Trading investments</span>
        <strong><%= formatMoney(overview.taxableInvestments) %></strong>
      </a>
      <a href="/portfolio?scope=retirement">
        <span>Retirement investments</span>
        <strong><%= formatMoney(overview.retirementInvestments) %></strong>
      </a>
    </div>
    <% if (nonUsdAccountCount) { %>
      <p class="card-note"><i class="ph ph-currency-circle-dollar"></i> <%= nonUsdAccountCount %> non-USD account<%= nonUsdAccountCount === 1 ? "" : "s" %> remain visible below and are excluded from totals.</p>
    <% } %>

    <% [...new Set(accounts.map((account) => account.institution))].forEach((institution) => {
      const institutionAccount = accounts.find(
        (account) => account.institution === institution,
      );
    %>
      <section class="card institution-card">
        <div class="institution-heading">
          <div class="institution-logo"><i class="ph ph-bank"></i></div>
          <div>
            <h2><%= institution %></h2>
            <p>
              <% if (institutionAccount.syncedAt) { %>
                <time
                  datetime="<%= institutionAccount.syncedAt %>"
                  data-local-date-time="<%= institutionAccount.syncedAt %>"
                  data-local-date-time-prefix="Synced "
                ><%= institutionAccount.freshness %></time>
              <% } else { %>
                <%= institutionAccount.freshness %>
              <% } %>
            </p>
          </div>
          <% if (viewer?.is_admin) { %>
            <a class="icon-button" href="/settings#connections" aria-label="Manage <%= institution %> connection"><i class="ph ph-pencil-simple"></i></a>
          <% } %>
        </div>
        <div class="account-list">
          <% accounts.filter((account) => account.institution === institution).forEach((account) => { %>
            <div
              id="account-<%= encodeURIComponent(account.id) %>"
              class="account-row <%= viewer?.is_admin ? '' : 'account-row--readonly' %>"
              data-account-id="<%= account.id %>"
            >
              <span class="account-icon account-icon--<%= account.tone %>"><i class="ph <%= account.icon %>"></i></span>
              <span class="account-row__identity">
                <strong
                  data-account-display-name="<%= account.id %>"
                  data-account-provider-name="<%= account.name %>"
                ><%= account.name %></strong>
                <small><%= account.type %> · •••• <%= account.mask %></small>
                <em class="balance-group-label"><%= accountGroupLabels[account.balanceGroup] || "Unclassified" %></em>
              </span>
              <span class="account-row__balance"><strong><%= formatMoney(account.balance) %></strong><small><%= account.available ? `${formatMoney(account.available)} available` : "Current value" %></small></span>
              <details class="account-row__actions" name="account-actions" data-account-actions>
                <summary
                  class="account-row__actions-trigger"
                  data-account-actions-trigger="<%= account.id %>"
                  data-account-provider-name="<%= account.name %>"
                  aria-label="Actions for <%= account.name %>"
                ><i class="ph ph-dots-three-vertical" aria-hidden="true"></i></summary>
                <div class="account-row__actions-panel">
                  <button
                    type="button"
                    data-account-alias-edit="<%= account.id %>"
                    data-account-provider-name="<%= account.name %>"
                    aria-label="Rename <%= account.name %> in this browser"
                  ><i class="ph ph-pencil-simple" aria-hidden="true"></i> Rename</button>
                  <% if (viewer?.is_admin) { %>
                    <a href="/settings#account-<%= encodeURIComponent(account.id) %>"><i class="ph ph-gear" aria-hidden="true"></i> Settings</a>
                  <% } %>
                </div>
              </details>
            </div>
          <% }) %>
        </div>
      </section>
    <% }) %>
    <% if (!accounts.length) { %>
      <section class="card settings-card">
        <p class="card-note"><i class="ph ph-bank"></i> No accounts are connected yet. Use Settings to connect one.</p>
      </section>
    <% } %>

    <dialog class="account-alias-dialog" data-account-alias-dialog aria-labelledby="account-alias-heading">
      <form class="account-alias-form" data-account-alias-form>
        <div class="account-alias-dialog__heading">
          <div>
            <span class="eyebrow">This browser only</span>
            <h2 id="account-alias-heading">Rename account</h2>
            <p>Plaid’s original name stays untouched.</p>
          </div>
          <button class="icon-button" type="button" aria-label="Close" data-account-alias-close><i class="ph ph-x"></i></button>
        </div>
        <label>
          <span>Display name</span>
          <input name="alias" maxlength="120" autocomplete="off" required data-account-alias-input>
          <small data-account-alias-provider></small>
        </label>
        <div class="form-actions">
          <button class="button button--ghost" type="button" data-account-alias-reset>Use original</button>
          <button class="button button--ghost" type="button" data-account-alias-close>Cancel</button>
          <button class="button button--dark" type="submit">Save name</button>
        </div>
        <p class="save-status" role="status" aria-live="polite" data-account-alias-status></p>
      </form>
    </dialog>

    <section id="manual-assets" class="card institution-card manual-assets-card">
      <div class="institution-heading">
        <div class="institution-logo institution-logo--neutral"><i class="ph ph-house-line"></i></div>
        <div><h2>Manually tracked assets</h2><p>Cars, homes, businesses, and other values Plaid cannot see.</p></div>
        <% if (viewer?.is_admin) { %>
          <a class="icon-button" href="/settings#manual-assets" aria-label="Manage manual assets"><i class="ph ph-pencil-simple"></i></a>
        <% } %>
      </div>
      <div class="account-list">
        <% accountManualAssets.forEach((asset) => { %>
          <div
            id="asset-<%= encodeURIComponent(asset.id) %>"
            class="account-row <%= viewer?.is_admin ? '' : 'account-row--readonly' %>"
          >
            <span class="account-icon"><i class="ph <%= manualAssetType(asset) === 'vehicle' ? 'ph-car' : manualAssetType(asset) === 'real_estate' ? 'ph-house-line' : 'ph-cube' %>"></i></span>
            <span class="account-row__identity">
              <strong><%= asset.name %></strong>
              <small><%= manualAssetType(asset).replaceAll("_", " ") %> · valued <%= asset.valuedOn || asset.asOf || "recently" %></small>
              <em class="balance-group-label">Other asset</em>
            </span>
            <span class="account-row__balance"><strong><%= formatMoney(asset.value) %></strong><small>Manual value</small></span>
            <% if (viewer?.is_admin) { %>
              <a class="button button--secondary account-row__edit" href="/settings?asset=<%= encodeURIComponent(asset.id) %>#asset-<%= encodeURIComponent(asset.id) %>" aria-label="Edit <%= asset.name %>">Edit</a>
            <% } %>
          </div>
        <% }) %>
        <% if (!accountManualAssets.length) { %>
          <p class="card-note manual-assets-card__empty">No manual assets yet. Add a car, home, or other asset in Settings.</p>
        <% } %>
      </div>
    </section>
  </main>
  <%- include("partials/footer") %>
