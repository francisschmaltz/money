<%- include("partials/head", { pageTitle }) %>
<body data-page="recurring">
  <%- include("partials/site-header", { activePath, viewer }) %>
  <%
    const subscriptionMonthlyMinor = subscriptions
      .filter((item) => item.amount.currency === "USD")
      .reduce((sum, item) => sum + item.amount.amount_minor, 0);
    const subscriptionCurrency = "USD";
    const subscriptionMonthly = { amount_minor: subscriptionMonthlyMinor, currency: subscriptionCurrency };
    const subscriptionAnnual = { amount_minor: subscriptionMonthlyMinor * 12, currency: subscriptionCurrency };
    const billMonthlyMinor = bills
      .filter((item) => item.amount.currency === "USD")
      .reduce((sum, item) => sum + item.amount.amount_minor, 0);
    const billCurrency = "USD";
    const billMonthly = { amount_minor: billMonthlyMinor, currency: billCurrency };
    const billAnnual = { amount_minor: billMonthlyMinor * 12, currency: billCurrency };
    const nonUsdCount = [...subscriptions, ...bills].filter(
      (item) => item.amount.currency !== "USD",
    ).length;
    const inactiveItems =
      typeof inactiveRecurring !== "undefined" ? inactiveRecurring : [];
  %>
  <main class="page-shell">
    <%- include("partials/page-heading", {
      eyebrow: freshness,
      pageTitle,
      pageDescription,
      actionLabel: "Subscription insights",
      actionHref: "/insights#subscriptions",
      actionIcon: "ph-sparkle"
    }) %>

    <% if (typeof selectedRecurring !== "undefined" && selectedRecurring) { %>
      <section class="card selected-detail" aria-labelledby="selected-recurring-heading">
        <span class="list-icon"><i class="ph <%= selectedRecurring.icon %>"></i></span>
        <div>
          <p class="card-kicker">Selected recurring payment</p>
          <h2 id="selected-recurring-heading"><%= selectedRecurring.name %></h2>
          <p><%= selectedRecurring.cadence %> · <%= selectedRecurring.account %> · <%= selectedRecurring.state %></p>
        </div>
        <strong><%= formatMoney(selectedRecurring.amount) %></strong>
        <a class="icon-button" href="/recurring" aria-label="Close recurring details"><i class="ph ph-x"></i></a>
      </section>
    <% } %>

    <section class="card recurring-card" aria-labelledby="subscriptions-heading" data-recurring-section>
      <div class="card-heading card-heading--align-start">
        <div>
          <p class="card-kicker"><%= subscriptions.length %> active</p>
          <h2 id="subscriptions-heading">Subscriptions</h2>
          <div class="segmented-control" aria-label="Subscription total period">
            <button type="button" aria-pressed="true" data-period="monthly">Monthly</button>
            <button type="button" aria-pressed="false" data-period="annual">Annual</button>
          </div>
        </div>
        <div class="card-total">
          <strong data-recurring-total data-monthly="<%= formatMoney(subscriptionMonthly) %>" data-annual="<%= formatMoney(subscriptionAnnual) %>"><%= formatMoney(subscriptionMonthly) %></strong>
          <span data-period-label>per month</span>
        </div>
      </div>
      <div class="recurring-list">
        <% subscriptions.forEach((item) => { %>
          <a href="/recurring?item=<%= item.id %>" class="recurring-row">
            <span class="list-icon"><i class="ph <%= item.icon %>"></i></span>
            <span class="recurring-row__main"><strong><%= item.name %></strong><span><%= item.cadence %> · <%= item.account %></span></span>
            <span class="recurring-row__date">Next <%= item.next %></span>
            <strong data-amount data-monthly="<%= formatMoney(item.amount) %>" data-annual="<%= formatMoney(item.annual) %>"><%= formatMoney(item.amount) %></strong>
          </a>
        <% }) %>
      </div>
      <% if (!subscriptions.length) { %>
        <p class="card-note"><i class="ph ph-info"></i> No active subscriptions are detected yet.</p>
      <% } %>
    </section>

    <section class="card recurring-card" aria-labelledby="bills-heading" data-recurring-section>
      <div class="card-heading card-heading--align-start">
        <div>
          <p class="card-kicker"><%= bills.length %> expected</p>
          <h2 id="bills-heading">Bills</h2>
          <div class="segmented-control" aria-label="Bill total period">
            <button type="button" aria-pressed="true" data-period="monthly">Monthly</button>
            <button type="button" aria-pressed="false" data-period="annual">Annual</button>
          </div>
        </div>
        <div class="card-total">
          <strong data-recurring-total data-monthly="<%= formatMoney(billMonthly) %>" data-annual="<%= formatMoney(billAnnual) %>"><%= formatMoney(billMonthly) %></strong>
          <span data-period-label>per month</span>
        </div>
      </div>
      <div class="recurring-list">
        <% bills.forEach((item) => { %>
          <a href="/recurring?item=<%= item.id %>" class="recurring-row">
            <span class="list-icon"><i class="ph <%= item.icon %>"></i></span>
            <span class="recurring-row__main"><strong><%= item.name %></strong><span><%= item.cadence %> · <%= item.account %></span></span>
            <span class="recurring-row__date">Expected <%= item.next %></span>
            <% const annualAmount = item.annual || { amount_minor: item.amount.amount_minor * 12, currency: item.amount.currency }; %>
            <strong data-amount data-monthly="<%= formatMoney(item.amount) %>" data-annual="<%= formatMoney(annualAmount) %>"><%= formatMoney(item.amount) %></strong>
          </a>
        <% }) %>
      </div>
      <% if (!bills.length) { %>
        <p class="card-note"><i class="ph ph-info"></i> No active bills are detected yet.</p>
      <% } %>
      <p class="card-note"><i class="ph ph-info"></i> Upcoming dates are estimates based on past charges.</p>
      <% if (nonUsdCount) { %>
        <p class="card-note"><i class="ph ph-currency-circle-dollar"></i> <%= nonUsdCount %> non-USD item<%= nonUsdCount === 1 ? "" : "s" %> remain visible but are excluded from USD totals.</p>
      <% } %>
    </section>

    <% if (inactiveItems.length) { %>
      <section class="card recurring-card" aria-labelledby="inactive-heading">
        <div class="card-heading">
          <div><p class="card-kicker">History</p><h2 id="inactive-heading">Inactive recurring payments</h2></div>
        </div>
        <div class="recurring-list">
          <% inactiveItems.forEach((item) => { %>
            <div class="recurring-row">
              <span class="list-icon"><i class="ph <%= item.icon %>"></i></span>
              <span class="recurring-row__main"><strong><%= item.name %></strong><span><%= item.cadence %> · <%= item.account %></span></span>
              <span class="recurring-row__date"><%= item.state %></span>
              <strong><%= formatMoney(item.amount) %></strong>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>
  <%- include("partials/footer") %>
