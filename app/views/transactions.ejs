<%- include("partials/head", { pageTitle }) %>
<%
  const selectedTransactionPeriod =
    typeof transactionPeriod !== "undefined"
      ? transactionPeriod
      : query.start && query.end
        ? "custom"
        : ["month", "30", "90", "365", "this-year", "last-year"].includes(query.period)
          ? query.period
          : "month";
  const selectedTransactionSort =
    typeof transactionSort !== "undefined"
      ? transactionSort
      : ["date", "merchant", "category", "cost"].includes(query.sort)
        ? query.sort
        : "date";
  const transactionQuery = (overrides = {}, removals = []) => {
    const parameters = new URLSearchParams();
    for (const key of [
      "q",
      "period",
      "start",
      "end",
      "category",
      "merchant",
      "account",
      "sort",
      "analytics_group",
    ]) {
      const value = query[key];
      if (value != null && String(value).trim()) {
        parameters.set(key, String(value).trim());
      }
    }
    for (const key of removals) parameters.delete(key);
    for (const [key, value] of Object.entries(overrides)) {
      if (value == null || String(value).trim() === "") {
        parameters.delete(key);
      } else {
        parameters.set(key, String(value));
      }
    }
    return `/transactions${parameters.size ? `?${parameters.toString()}` : ""}`;
  };
  const shiftMonth = (monthOn, offset) => {
    const date = new Date(`${String(monthOn).slice(0, 7)}-01T00:00:00.000Z`);
    date.setUTCMonth(date.getUTCMonth() + offset);
    return date.toISOString().slice(0, 10);
  };
  const formatPlanMonth = (monthOn) =>
    new Intl.DateTimeFormat("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(`${monthOn}T00:00:00.000Z`));
%>
<body data-page="transactions">
  <%- include("partials/site-header", { activePath, viewer }) %>
  <main class="page-shell">
    <%- include("partials/page-heading", {
      eyebrow: freshness,
      pageTitle,
      actionLabel: "Search",
      actionHref: "/search",
      actionIcon: "ph-magnifying-glass"
    }) %>

    <form
      class="filter-bar transaction-filter"
      action="/transactions"
      method="get"
      data-transaction-filter
    >
      <div class="transaction-filter__fields">
        <label class="filter-field">
          <span class="filter-field-label">Timeline</span>
          <select name="period">
            <option value="month" <%= selectedTransactionPeriod === "month" ? "selected" : "" %>>This Month</option>
            <option value="30" <%= selectedTransactionPeriod === "30" ? "selected" : "" %>>Past 30 Days</option>
            <option value="90" <%= selectedTransactionPeriod === "90" ? "selected" : "" %>>Past 90 Days</option>
            <option value="365" <%= selectedTransactionPeriod === "365" ? "selected" : "" %>>Past 365 Days</option>
            <option value="this-year" <%= selectedTransactionPeriod === "this-year" ? "selected" : "" %>>This Year</option>
            <option value="last-year" <%= selectedTransactionPeriod === "last-year" ? "selected" : "" %>>Last Year</option>
            <% if (selectedTransactionPeriod === "custom") { %>
              <option value="custom" selected>Custom dates</option>
            <% } %>
          </select>
        </label>
      <% if (query.start && query.end) { %>
        <input type="hidden" name="start" value="<%= query.start %>">
        <input type="hidden" name="end" value="<%= query.end %>">
      <% } %>
        <% if (query.analytics_group) { %>
          <input type="hidden" name="analytics_group" value="<%= query.analytics_group %>">
        <% } %>
        <% if (query.merchant) { %>
          <input type="hidden" name="merchant" value="<%= query.merchant %>">
        <% } %>
        <label class="filter-field">
          <span class="filter-field-label">Category</span>
          <select name="category">
            <option value="">All categories</option>
            <% categories.forEach((category) => { %><option value="<%= category.value ?? category.label %>" <%= (query.category_id || query.category) === (category.value ?? category.label) ? "selected" : "" %>><%= category.label %></option><% }) %>
          </select>
        </label>
        <label class="filter-field">
          <span class="filter-field-label">Account</span>
          <select name="account">
            <option value="">All accounts</option>
            <% accounts.forEach((account) => { %><option value="<%= account.id %>" data-account-display-name="<%= account.id %>" data-account-provider-name="<%= account.name %>" <%= query.account === account.id ? "selected" : "" %>><%= account.name %></option><% }) %>
          </select>
        </label>
        <label class="filter-field">
          <span class="filter-field-label">Sort</span>
          <select name="sort">
            <option value="date" <%= selectedTransactionSort === "date" ? "selected" : "" %>>Date (newest first)</option>
            <option value="merchant" <%= selectedTransactionSort === "merchant" ? "selected" : "" %>>Merchant (A–Z)</option>
            <option value="category" <%= selectedTransactionSort === "category" ? "selected" : "" %>>Category (A–Z)</option>
            <option value="cost" <%= selectedTransactionSort === "cost" ? "selected" : "" %>>Spending amount (high to low)</option>
          </select>
        </label>
      </div>
      <label class="transaction-filter__search">
        <span class="filter-field-label">Search</span>
        <span class="transaction-filter__search-control">
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          <input type="search" name="q" value="<%= query.q || '' %>" placeholder="Merchant, category, or note">
        </span>
      </label>
      <div class="transaction-filter__actions">
        <% if (query.merchant) { %>
          <span class="filter-chip">Merchant: <strong><%= query.merchant %></strong> <a href="<%= transactionQuery({ merchant: null }, ['cursor']) %>" aria-label="Clear merchant filter"><i class="ph ph-x" aria-hidden="true"></i></a></span>
        <% } %>
        <button class="button button--dark" type="submit" data-transaction-filter-submit>Apply</button>
      </div>
    </form>

    <% if (typeof selectedTransaction !== "undefined" && selectedTransaction) { %>
      <dialog
        class="entity-detail-dialog entity-detail-dialog--transaction"
        data-detail-dialog
        data-detail-auto-open
        data-detail-query-key="transaction"
        aria-labelledby="selected-transaction-heading"
      >
        <div class="entity-detail-dialog__panel">
      <section class="selected-detail entity-detail-dialog__summary" aria-labelledby="selected-transaction-heading">
        <span class="list-icon"><i class="ph <%= selectedTransaction.icon %>"></i></span>
        <div>
          <p class="card-kicker">Transaction details</p>
          <h2 id="selected-transaction-heading"><%= selectedTransaction.merchant %></h2>
          <p>
            <span
              <% if (selectedTransaction.accountId) { %>
                data-account-display-name="<%= selectedTransaction.accountId %>"
                data-account-provider-name="<%= selectedTransaction.account %>"
                data-account-prefix="<%= `${selectedTransaction.category} · ` %>"
              <% } %>
            ><%= selectedTransaction.category %> · <%= selectedTransaction.account %></span>
            · <%- include("partials/transaction-date", { transaction: selectedTransaction }) %><%= selectedTransaction.status === "pending" ? " · Pending" : "" %><%= selectedTransaction.tags?.length ? ` · ${selectedTransaction.tags.join(" · ")}` : "" %>
          </p>
        </div>
        <strong><%= formatMoney(selectedTransaction.amount) %></strong>
        <button class="icon-button" type="button" data-detail-dialog-close aria-label="Close transaction details"><i class="ph ph-x" aria-hidden="true"></i></button>
      </section>
      <div class="entity-detail-dialog__body entity-detail-dialog__body--transaction">
          <section class="transaction-note-editor" aria-labelledby="transaction-note-heading">
            <div>
              <h3 id="transaction-note-heading">Note</h3>
              <p>Shared with everyone in this household.</p>
            </div>
            <form
              data-transaction-note-form
              data-transaction-id="<%= selectedTransaction.id %>"
              data-note-version="<%= selectedTransaction.noteVersion ?? 0 %>"
            >
              <label>
                <span class="sr-only">Transaction note</span>
                <textarea
                  name="note"
                  maxlength="2000"
                  rows="3"
                  placeholder="What was this for?"
                  data-transaction-note-input
                ><%= selectedTransaction.note || "" %></textarea>
              </label>
              <div class="transaction-note-editor__footer">
                <small><span data-transaction-note-count><%= (selectedTransaction.note || "").length %></span>/2000</small>
                <% if (selectedTransaction.noteUpdatedAt) { %>
                  <small data-transaction-note-updated>Updated <time datetime="<%= selectedTransaction.noteUpdatedAt %>" data-local-date-time="<%= selectedTransaction.noteUpdatedAt %>"><%= selectedTransaction.noteUpdatedAt %></time></small>
                <% } else { %>
                  <small data-transaction-note-updated></small>
                <% } %>
                <span class="form-status" role="status" data-transaction-note-status></span>
                <button class="button button--secondary" type="submit">Save note</button>
              </div>
            </form>
          </section>
          <%
            const transactionOrganizeFormId =
              `transaction-organize-${selectedTransaction.id}`;
            const canOrganizeTransaction =
              viewer?.is_admin && selectedTransaction.status !== "pending";
            const selectedTransactionPostedOn =
              selectedTransaction.dateIso ||
              selectedTransaction.postedOn ||
              selectedTransaction.date;
            const selectedTransactionPostedMonth =
              `${String(selectedTransactionPostedOn).slice(0, 7)}-01`;
          %>
          <dl class="entity-detail-grid entity-detail-grid--transaction">
            <div><dt>Original merchant</dt><dd><%= selectedTransaction.rawMerchant || "—" %></dd></div>
            <div><dt>Statement description</dt><dd><%= selectedTransaction.rawName || "—" %></dd></div>
            <div><dt>Account</dt><dd><%= selectedTransaction.account %><%= selectedTransaction.accountMask ? ` · ••••${selectedTransaction.accountMask}` : "" %></dd></div>
            <div><dt>Institution</dt><dd><%= selectedTransaction.institution || "—" %></dd></div>
            <div class="entity-detail-grid__category">
              <dt>Spending category</dt>
              <dd>
                <% if (canOrganizeTransaction) {
                  const selectedCategory =
                    selectedTransaction.categoryValue ||
                    selectedTransaction.category;
                  const hasSelectedCategory = categories.some(
                    (category) => category.label === selectedCategory
                  );
                %>
                  <select
                    name="category_primary"
                    form="<%= transactionOrganizeFormId %>"
                    data-transaction-organize-category
                    data-initial-value="<%= selectedCategory %>"
                    aria-label="Spending category"
                  >
                    <% if (!hasSelectedCategory) { %>
                      <option value="<%= selectedCategory %>" selected><%= selectedCategory %></option>
                    <% } %>
                    <% categories.forEach((category) => { %>
                      <option value="<%= category.label %>" <%= category.label === selectedCategory ? "selected" : "" %>><%= category.label %></option>
                    <% }) %>
                  </select>
                <% } else { %>
                  <%= selectedTransaction.categoryValue || selectedTransaction.category %>
                <% } %>
              </dd>
            </div>
            <div><dt>Source category</dt><dd><%= selectedTransaction.originalCategoryValue || "—" %></dd></div>
            <div><dt>Source detail</dt><dd><%= selectedTransaction.originalDetailedCategoryValue || selectedTransaction.detailedCategoryValue || "—" %></dd></div>
            <div><dt>Provider amount</dt><dd><%= formatMoney(selectedTransaction.providerAmount || selectedTransaction.amount) %></dd></div>
            <div><dt>Status</dt><dd><%= selectedTransaction.status %></dd></div>
            <div><dt>Authorized</dt><dd><%= selectedTransaction.authorizedAt || selectedTransaction.authorizedOn || "—" %></dd></div>
            <div><dt>Posted</dt><dd><%= selectedTransaction.postedAt || selectedTransaction.postedOn || selectedTransaction.dateIso || selectedTransaction.date %></dd></div>
            <div><dt>Plan month</dt><dd><%= formatPlanMonth(selectedTransaction.effectiveBudgetMonthOn || selectedTransactionPostedMonth) %><%= selectedTransaction.budgetMonthOn ? " · Manually applied" : " · Posted month" %></dd></div>
            <div><dt>Payment channel</dt><dd><%= selectedTransaction.paymentChannel || "—" %></dd></div>
            <div><dt>Transaction type</dt><dd><%= selectedTransaction.sourceTransactionType || "—" %></dd></div>
            <div><dt>Cardholder</dt><dd><%= selectedTransaction.cardholderName || "—" %></dd></div>
            <div><dt>Original transaction</dt><dd><code><%= selectedTransaction.originalTransactionId || "—" %></code></dd></div>
            <div><dt>Excluded from spending</dt><dd><%= selectedTransaction.excludedFromSpending ? "Yes" : "No" %></dd></div>
            <div><dt>Fixed expense</dt><dd><%= selectedTransaction.isFixed ? "Yes" : "No" %></dd></div>
            <div class="entity-detail-grid__wide"><dt>Transaction ID</dt><dd><code><%= selectedTransaction.id %></code></dd></div>
            <div class="entity-detail-grid__wide"><dt>Provider transaction ID</dt><dd><code><%= selectedTransaction.providerTransactionId || "—" %></code></dd></div>
          </dl>
          <% if (canOrganizeTransaction) { %>
            <%
              const postedBudgetMonth = selectedTransactionPostedMonth;
              const effectiveBudgetMonth =
                selectedTransaction.effectiveBudgetMonthOn || postedBudgetMonth;
              const selectedBudgetMonthOffset =
                effectiveBudgetMonth === shiftMonth(postedBudgetMonth, -1)
                  ? -1
                  : effectiveBudgetMonth === shiftMonth(postedBudgetMonth, 1)
                    ? 1
                    : 0;
            %>
            <section class="transaction-organize" aria-labelledby="transaction-organize-heading">
              <div>
                <h3 id="transaction-organize-heading">Organize transaction</h3>
                <p>One-time edits only. No automatic cleanup rule is created.</p>
              </div>
              <form
                id="<%= transactionOrganizeFormId %>"
                data-transaction-organize-form
                data-transaction-id="<%= selectedTransaction.id %>"
              >
                <label>
                  Merchant name
                  <input
                    name="display_name"
                    maxlength="160"
                    value="<%= selectedTransaction.displayName %>"
                    data-initial-value="<%= selectedTransaction.displayName %>"
                  >
                </label>
                <label>
                  Tags
                  <input
                    name="tags"
                    maxlength="400"
                    value="<%= selectedTransaction.tags?.join(", ") || "" %>"
                    data-initial-value="<%= selectedTransaction.tags?.join(", ") || "" %>"
                    placeholder="household, reimbursable"
                  >
                </label>
                <label>
                  Spending treatment
                  <select
                    name="excluded_from_spending"
                    data-initial-value="<%= String(Boolean(selectedTransaction.excludedFromSpending)) %>"
                  >
                    <option value="false" <%= !selectedTransaction.excludedFromSpending ? "selected" : "" %>>Include in spending</option>
                    <option value="true" <%= selectedTransaction.excludedFromSpending ? "selected" : "" %>>Exclude from spending</option>
                  </select>
                </label>
                <label>
                  Apply to Plan month
                  <select
                    name="budget_month_offset"
                    data-initial-value="<%= selectedBudgetMonthOffset %>"
                  >
                    <option value="-1" <%= selectedBudgetMonthOffset === -1 ? "selected" : "" %>><%= formatPlanMonth(shiftMonth(postedBudgetMonth, -1)) %> · Previous month</option>
                    <option value="0" <%= selectedBudgetMonthOffset === 0 ? "selected" : "" %>><%= formatPlanMonth(postedBudgetMonth) %> · Posted month</option>
                    <option value="1" <%= selectedBudgetMonthOffset === 1 ? "selected" : "" %>><%= formatPlanMonth(shiftMonth(postedBudgetMonth, 1)) %> · Next month</option>
                  </select>
                  <small>Only Plan actuals move. The posted date and every other report stay unchanged.</small>
                </label>
                <div class="transaction-organize__footer">
                  <span class="form-status" role="status" data-transaction-organize-status></span>
                  <button class="button button--secondary" type="submit">Save changes</button>
                </div>
              </form>
            </section>
            <a class="selected-detail__link" href="/format-rules?transaction=<%= encodeURIComponent(selectedTransaction.id) %>#transaction-cleanup">
              Edit similar transactions or create a rule <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          <% } %>
          <% if (
            selectedTransaction.status !== "pending" &&
            selectedTransaction.amount.currency === "USD"
          ) {
            const providerAmount =
              selectedTransaction.providerAmount ??
              selectedTransaction.amount;
            const absoluteMinor = Math.abs(providerAmount.amount_minor);
            const firstHalf = Math.floor(absoluteMinor / 2);
            const secondHalf = absoluteMinor - firstHalf;
            const splitRows =
              typeof selectedTransactionSplits !== "undefined" &&
              selectedTransactionSplits.length >= 2
                ? selectedTransactionSplits.map((line) => [
                    Math.abs(line.amount_minor),
                    line.category,
                  ])
                : [
                    [
                      firstHalf,
                      selectedTransaction.categoryValue ??
                        selectedTransaction.category,
                    ],
                    [secondHalf, "Other"],
                  ];
          %>
            <details class="transaction-split-editor">
              <summary>Split this transaction</summary>
              <form
                data-plan-form
                data-transaction-split
                data-source-amount="<%= providerAmount.amount_minor %>"
                data-endpoint="/api/v1/transactions/<%= encodeURIComponent(selectedTransaction.id) %>/splits"
                data-method="PUT"
              >
                <input type="hidden" name="expected_version" value="<%= typeof selectedTransactionSplitVersion === 'number' ? selectedTransactionSplitVersion : selectedTransaction.splitVersion %>">
                <% splitRows.forEach(([amount, category], index) => { %>
                  <div data-split-line>
                    <label>Category <select data-split-category><% if (!categories.some((option) => (option.value ?? option.label) === category)) { %><option value="<%= category %>" selected><%= category %></option><% } %><% categories.forEach((option) => { const optionValue = option.value ?? option.label; %><option value="<%= optionValue %>" <%= optionValue === category ? "selected" : "" %>><%= option.label %></option><% }) %></select></label>
                    <label>Amount <span class="money-input"><span>$</span><input data-split-amount inputmode="decimal" value="<%= (amount / 100).toFixed(2) %>" aria-label="Split <%= index + 1 %> amount"></span></label>
                  </div>
                <% }) %>
                <div class="selected-detail__actions">
                  <button class="button button--secondary" type="submit">Save split</button>
                  <button class="button button--ghost" type="submit" data-clear-split>Clear split</button>
                  <span class="form-status" data-plan-status aria-live="polite"></span>
                </div>
              </form>
            </details>
          <% } else if (selectedTransaction.status !== "pending") { %>
            <p class="card-note">Transaction splits currently support USD only.</p>
          <% } %>
          <%
            const goalSpending =
              typeof selectedTransactionGoalSpending !== "undefined"
                ? selectedTransactionGoalSpending
                : null;
            const goalSpends = goalSpending?.goal_spends ?? [];
            const canAddGoalSpend =
              goalSpending?.eligible === true &&
              selectedTransaction.status === "posted" &&
              selectedTransaction.amount.currency === "USD" &&
              (selectedTransaction.providerAmount ?? selectedTransaction.amount).amount_minor < 0;
          %>
          <% if (goalSpending && (goalSpends.length || canAddGoalSpend)) {
            const activeGoals =
              typeof selectedTransactionGoals !== "undefined"
                ? selectedTransactionGoals.filter(
                    (goal) => goal.status === "active",
                  )
                : [];
            const sourceAmountMinor = Math.abs(
              (selectedTransaction.providerAmount ?? selectedTransaction.amount).amount_minor,
            );
            const assignedAmountMinor = goalSpends.reduce(
              (sum, spend) => sum + Math.abs(Number(spend.amount_minor) || 0),
              0,
            );
            const unassignedAmountMinor = Math.max(
              0,
              sourceAmountMinor - assignedAmountMinor,
            );
            const goalSpendVersion =
              goalSpending?.goal_spend_version ??
              selectedTransaction.goalSpendVersion ??
              0;
          %>
            <details class="transaction-goal-editor">
              <summary>Spend from goal</summary>
              <% if (goalSpends.length) { %>
                <ul class="transaction-goal-spends" aria-label="Goal spending assigned to this transaction">
                  <% goalSpends.forEach((spend) => { %>
                    <li>
                      <span>
                        <strong><%= spend.goal_name %></strong>
                        <small><%= spend.source === "brokerage" ? "Brokerage" : "Cash" %> · <%= formatMoney({ amount_minor: Math.abs(spend.amount_minor), currency: "USD" }) %></small>
                      </span>
                      <form
                        data-plan-form
                        data-endpoint="/api/v1/transactions/<%= encodeURIComponent(selectedTransaction.id) %>/goal-spends/<%= encodeURIComponent(spend.id) %>"
                        data-method="DELETE"
                      >
                        <input type="hidden" name="expected_goal_version" value="<%= spend.goal_version %>">
                        <input type="hidden" name="expected_transaction_version" value="<%= goalSpendVersion %>">
                        <button class="button button--ghost" type="submit" aria-label="Undo <%= formatMoney({ amount_minor: Math.abs(spend.amount_minor), currency: 'USD' }) %> spent from <%= spend.goal_name %>">Undo</button>
                        <span class="form-status" data-plan-status aria-live="polite"></span>
                      </form>
                    </li>
                  <% }) %>
                </ul>
              <% } %>

              <% if (!canAddGoalSpend) { %>
                <p class="card-note"><%= goalSpending.ineligible_reason || "This transaction cannot take new goal spending, but its existing history can still be undone." %></p>
              <% } else if (unassignedAmountMinor > 0 && activeGoals.length) { %>
                <form
                  class="transaction-goal-spend-form"
                  data-plan-form
                  data-goal-spend-form
                  data-endpoint="/api/v1/transactions/<%= encodeURIComponent(selectedTransaction.id) %>/goal-spends"
                  data-method="POST"
                >
                  <label>Goal
                    <select name="goal_id" data-goal-spend-select required>
                      <option value="">Choose a goal</option>
                      <% activeGoals.forEach((goal) => { %>
                        <option
                          value="<%= goal.id %>"
                          data-goal-version="<%= goal.version %>"
                          data-cash-earmarked="<%= goal.cash_earmarked?.amount_minor ?? 0 %>"
                          data-brokerage-earmarked="<%= goal.brokerage_earmarked?.amount_minor ?? 0 %>"
                        ><%= goal.name %></option>
                      <% }) %>
                    </select>
                  </label>
                  <input type="hidden" name="expected_goal_version" data-goal-spend-version value="">
                  <input type="hidden" name="expected_transaction_version" value="<%= goalSpendVersion %>">
                  <label>From
                    <select name="source" data-goal-spend-source required>
                      <option value="cash" data-source-label="Cash">Cash · overspend allowed</option>
                      <option value="brokerage" data-source-label="Brokerage">Brokerage · overspend allowed</option>
                    </select>
                  </label>
                  <label>Amount
                    <span class="money-input"><span>$</span><input data-money-minor="amount_minor" inputmode="decimal" min="0.01" value="<%= (unassignedAmountMinor / 100).toFixed(2) %>" required></span>
                  </label>
                  <div class="selected-detail__actions">
                    <button class="button button--secondary" type="submit">Use goal</button>
                    <span class="form-status" data-plan-status aria-live="polite"></span>
                  </div>
                </form>
              <% } else if (unassignedAmountMinor === 0) { %>
                <p class="card-note">This transaction is fully assigned to goals.</p>
              <% } else { %>
                <p class="card-note">Create an active goal before assigning this purchase.</p>
              <% } %>
            </details>
          <% } %>
      </div>
        </div>
      </dialog>
    <% } %>

    <%
      const rawSpendingGroupings = spendingDetails.groupings ?? {
        category: {
          key: "category",
          label: "Category",
          seriesInterval: spendingDetails.seriesInterval ?? "day",
          seriesLabels: spendingDetails.seriesLabels,
          seriesValues: spendingDetails.seriesValues,
          segments: spendingDetails.categories,
        },
      };
      const spendingGroupings = Object.fromEntries(
        Object.entries(rawSpendingGroupings).map(([groupKey, grouping]) => [
          groupKey,
          {
            ...grouping,
            key: grouping.key ?? groupKey,
            label: grouping.label ?? (groupKey === "merchant" ? "Merchant" : "Category"),
            seriesInterval: grouping.seriesInterval ?? spendingDetails.seriesInterval ?? "day",
            seriesLabels: grouping.seriesLabels ?? spendingDetails.seriesLabels ?? [],
            seriesValues: grouping.seriesValues ?? spendingDetails.seriesValues ?? [],
            segments: (grouping.segments ?? []).map((segment, index) => ({
              ...segment,
              key: segment.key ?? `${groupKey}-legacy-${index}`,
              grouping: segment.grouping ?? groupKey,
              seriesLabels: segment.seriesLabels ?? grouping.seriesLabels ?? spendingDetails.seriesLabels ?? [],
              seriesValues: segment.seriesValues ?? grouping.seriesValues ?? spendingDetails.seriesValues ?? [],
            })),
          },
        ]),
      );
      const activeSpendingGroup =
        spendingGroupings[spendingDetails.activeGrouping] ??
        spendingGroupings.category ??
        Object.values(spendingGroupings)[0];
      const activeSpendingSegments = activeSpendingGroup?.segments ?? [];
      const activeSpendingGroupPlural =
        activeSpendingGroup?.key === "category"
          ? "categories"
          : `${activeSpendingGroup?.label?.toLowerCase() ?? "group"}s`;
      const activeSpendingFilter =
        activeSpendingGroup?.key === "merchant"
          ? query.merchant
          : query.category_id || query.category;
      const activeSpendingFilterLabel =
        activeSpendingFilter
          ? activeSpendingSegments[0]?.label ?? activeSpendingFilter
          : null;
      const selectedSpendingSegment = null;
      const spendingSeriesInterval =
        spendingDetails.seriesInterval ??
        activeSpendingGroup?.seriesInterval ??
        "day";
      const spendingSeriesIntervalTitle =
        { day: "Daily", week: "Weekly", month: "Monthly" }[spendingSeriesInterval] ??
        "Spending";
      const spendingSeriesTitle =
        spendingDetails.seriesTitle ??
        `${spendingSeriesIntervalTitle}${selectedSpendingSegment ? ` ${selectedSpendingSegment.label}` : ""} spending`;
      const hasEligibleSpending =
        spendingDetails.hasEligibleSpending ??
        spendingDetails.transactionCount > 0;
      const showSpendingCharts =
        hasEligibleSpending &&
        spendingDetails.emptyReason !== "zero_net_spending";
      const spendingExplorerJson = JSON.stringify(spendingGroupings).replaceAll("<", "\\u003c");
    %>
    <section
      class="card spending-detail-card"
      aria-labelledby="transaction-spending-heading"
      data-spending-explorer
      data-active-group="<%= activeSpendingGroup?.key ?? 'category' %>"
      data-period-label="<%= spendingDetails.periodLabel %>"
    >
      <script type="application/json" data-spending-explorer-data><%- spendingExplorerJson %></script>

      <% if (showSpendingCharts) { %>
        <div class="card-heading spending-detail-heading">
          <div>
            <p class="card-kicker"><%= spendingDetails.periodLabel %></p>
            <h2 id="transaction-spending-heading">Spending detail</h2>
          </div>
          <div class="card-total">
            <strong><%= formatMoney(spendingDetails.total) %></strong>
            <span class="trend <%= spendingDetails.trendDirection === 'up' ? 'trend--negative' : spendingDetails.trendDirection === 'down' ? 'trend--positive' : '' %>">
              <%= spendingDetails.trendLabel %>
            </span>
          </div>
        </div>

        <dl class="spending-detail-metrics" aria-label="Spending totals">
          <div>
            <dt>Prior period</dt>
            <dd><%= formatMoney(spendingDetails.previousTotal) %><small><%= spendingDetails.previousPeriodLabel %></small></dd>
          </div>
          <div>
            <dt>Included activity</dt>
            <dd><%= spendingDetails.transactionCount %><small>Posted spending and refunds; pending and excluded activity is omitted</small></dd>
          </div>
          <div>
            <dt>Average included transaction</dt>
            <dd><%= formatMoney(spendingDetails.averageTransaction) %><small>Across included spending and refunds</small></dd>
          </div>
        </dl>

        <div class="spending-explorer-toolbar">
          <div>
            <span class="filter-field-label">Group spending by</span>
            <div class="segmented-control spending-group-control" aria-label="Group spending by">
              <% Object.values(spendingGroupings).forEach((grouping) => { %>
                <a
                  class="segmented-control__option"
                  href="<%= transactionQuery({ analytics_group: grouping.key }, ['cursor']) %>"
                  data-spending-group
                  data-group="<%= grouping.key %>"
                  aria-current="<%= grouping.key === activeSpendingGroup.key ? 'true' : 'false' %>"
                ><%= grouping.label %></a>
              <% }) %>
            </div>
          </div>
          <p class="card-note" data-spending-selection-status aria-live="polite">
            <%= activeSpendingGroup.key === "category" && query.category
              ? `Filtering transactions by ${categories.find((category) => (category.value ?? category.label) === (query.category_id || query.category))?.label ?? query.category} and its descendants.`
              : activeSpendingGroup.key === "merchant" && query.merchant
                ? `Filtering transactions by merchant ${query.merchant}.`
                : `Showing all ${activeSpendingGroup.label.toLowerCase()} spending.` %>
          </p>
        </div>

        <div class="spending-chart-wrap spending-chart-wrap--detail">
          <canvas
            data-chart="spending"
            data-spending-breakdown-chart
            data-labels="<%= JSON.stringify(activeSpendingSegments.map((segment) => segment.label)) %>"
            data-values="<%= JSON.stringify(activeSpendingSegments.map((segment) => segment.amount.amount_minor)) %>"
            data-colors="<%= JSON.stringify(activeSpendingSegments.map((segment) => segment.color)) %>"
            aria-label="<%= spendingDetails.periodLabel %> spending grouped by <%= activeSpendingGroup.label.toLowerCase() %>. <%= activeSpendingSegments.map((segment) => `${segment.label} ${formatMoney(segment.amount)}`).join(', ') %>"
            role="img"
          ></canvas>
        </div>

        <div class="spending-detail-layout">
          <div class="spending-detail-trend">
            <div class="subsection-heading">
              <div>
                <h3 data-spending-series-title><%= spendingSeriesTitle %></h3>
                <p>Summed <span data-spending-series-interval><%= spendingSeriesInterval %></span> buckets. Refunds reduce spending; no activity is sampled away.</p>
              </div>
            </div>
            <div class="chart-frame chart-frame--spending-detail">
              <canvas
                data-chart="line"
                data-spending-line-chart
                data-labels="<%= JSON.stringify(spendingDetails.seriesLabels) %>"
                data-values="<%= JSON.stringify(spendingDetails.seriesValues) %>"
                data-color="#2f8f4e"
                aria-label="<%= spendingSeriesTitle %> for <%= spendingDetails.periodLabel %>"
                role="img"
              ></canvas>
            </div>
          </div>

          <div class="spending-detail-categories">
            <div class="subsection-heading spending-segment-heading">
              <div>
                <h3 data-spending-segment-heading><%= activeSpendingFilterLabel ?? `All ${activeSpendingGroupPlural}` %></h3>
                <p>Choose a group to filter the chart and transactions.</p>
              </div>
              <a
                class="button button--ghost button--compact"
                href="<%= transactionQuery({ [activeSpendingGroup.key === 'merchant' ? 'merchant' : 'category']: null }, ['cursor']) %>"
                data-spending-segment-reset
                <%= (activeSpendingGroup.key === "merchant" ? query.merchant : (query.category_id || query.category)) ? "" : "hidden" %>
              >Clear <%= activeSpendingGroup.label.toLowerCase() %></a>
            </div>
            <div class="spending-detail-category-list" data-spending-segment-list>
              <% activeSpendingSegments.forEach((segment, index) => { %>
                <%
                  const isAggregate = segment.key === `${activeSpendingGroup.key}-other`;
                  const filterName = activeSpendingGroup.key === "merchant" ? "merchant" : "category";
                %>
                <article class="spending-detail-category" data-spending-segment-item>
                  <% if (!isAggregate) { %><a
                    class="spending-detail-category__select"
                    href="<%= transactionQuery({ analytics_group: activeSpendingGroup.key, [filterName]: segment.value }, ['cursor']) %>"
                    data-spending-segment
                    data-segment-key="<%= segment.key %>"
                  ><% } else { %><div class="spending-detail-category__select" aria-label="Other groups combined"><% } %>
                    <span class="category-dot" style="--category-color: <%= segment.color %>" aria-hidden="true"></span>
                    <span class="list-icon list-icon--compact" aria-hidden="true"><i class="ph <%= segment.icon %>"></i></span>
                    <span>
                      <strong><%= isAggregate ? "Other groups combined" : segment.label %></strong>
                      <small><%= segment.percent %>% · <%= segment.count %> transaction<%= segment.count === 1 ? "" : "s" %></small>
                    </span>
                    <strong><%= formatMoney(segment.amount) %></strong>
                  <% if (!isAggregate) { %></a><% } else { %></div><% } %>
                </article>
              <% }) %>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="spending-empty" data-spending-empty role="status">
          <span class="spending-empty__icon" aria-hidden="true"><i class="ph ph-chart-line-down"></i></span>
          <div>
            <p class="card-kicker"><%= spendingDetails.periodLabel %></p>
            <h2 id="transaction-spending-heading">
              <%= spendingDetails.emptyReason === "no_matches" ? "No matching transactions" : spendingDetails.emptyReason === "zero_net_spending" ? "Spending nets to zero" : "No spending to chart" %>
            </h2>
            <% if (spendingDetails.emptyReason === "no_matches") { %>
              <p>No transactions match the current filters. Clear or adjust them to restore the spending view.</p>
            <% } else if (spendingDetails.emptyReason === "zero_net_spending") { %>
              <p>Included purchases and refunds cancel out for this period, so a flat $0 chart would be misleading.</p>
            <% } else { %>
              <p><%= spendingDetails.eligibility?.matchedTransactionCount ?? transactions.length %> matching transaction<%= (spendingDetails.eligibility?.matchedTransactionCount ?? transactions.length) === 1 ? "" : "s" %> remain visible below, but they are income, transfers, pending, excluded from spending, or otherwise ineligible.</p>
            <% } %>
            <% if (spendingDetails.eligibility?.excludedTransactionCount) { %>
              <p class="card-note"><%= spendingDetails.eligibility.excludedTransactionCount %> matched row<%= spendingDetails.eligibility.excludedTransactionCount === 1 ? " is" : "s are" %> excluded from spending totals.</p>
            <% } %>
          </div>
        </div>
      <% } %>
    </section>

    <section class="ledger-summary" aria-label="Transaction summary">
      <div><span>Money in</span><strong class="money-positive"><%= formatMoney(overview.income) %></strong></div>
      <div><span>Posted spending</span><strong><%= formatMoney(overview.spending) %></strong></div>
      <div><span>Net cash flow</span><strong class="<%= overview.cashFlow.amount_minor >= 0 ? 'money-positive' : 'money-negative' %>"><%= formatMoney(overview.cashFlow, { sign: true }) %></strong></div>
    </section>

    <section class="card list-card" data-bulk-transactions>
      <div class="card-heading">
        <div>
          <p class="card-kicker">Selected period</p>
          <h2>All transactions</h2>
        </div>
        <div class="transaction-list-actions">
          <% if (viewer?.is_admin) { %>
            <button class="button button--secondary" type="button" data-bulk-select-start <%= transactions.some((transaction) => transaction.status !== "pending") ? "" : "disabled" %>>
              <i class="ph ph-check-square-offset" aria-hidden="true"></i> Select &amp; edit
            </button>
          <% } %>
          <button class="button button--secondary" type="button" data-download <%= transactions.length ? "" : "disabled" %>>
            <i class="ph ph-download-simple" aria-hidden="true"></i> Export
          </button>
        </div>
      </div>
      <% if (viewer?.is_admin) { %>
        <div class="transaction-selection-bar" data-bulk-selection-bar hidden>
          <label>
            <input type="checkbox" data-bulk-select-all>
            Select all posted on this page
          </label>
          <strong data-bulk-selected-count role="status" aria-live="polite">0 selected</strong>
          <span class="transaction-selection-bar__limit">Up to 100 · one-time edits only</span>
          <button class="button button--dark" type="button" data-bulk-edit-open disabled>Edit selected</button>
          <button class="button button--ghost" type="button" data-bulk-select-cancel>Cancel</button>
        </div>
      <% } %>
      <div class="transaction-list transaction-list--ledger">
        <% transactions.forEach((transaction) => { %>
          <%- include("partials/transaction-row", { transaction, selectable: true }) %>
        <% }) %>
        <% if (!transactions.length) { %>
          <p class="card-note"><i class="ph ph-receipt"></i> No transactions match these filters.</p>
        <% } %>
      </div>
      <div class="pagination">
        <span>Showing <%= transactions.length %> transactions</span>
        <% if (typeof transactionPageInfo !== "undefined" && transactionPageInfo?.has_more && transactionPageInfo.next_cursor) { %>
          <a class="button button--secondary" href="/transactions?<%= new URLSearchParams({ ...query, sort: selectedTransactionSort, cursor: transactionPageInfo.next_cursor }).toString() %>">Next page</a>
        <% } else { %>
          <button type="button" class="button button--secondary" disabled>End of results</button>
        <% } %>
      </div>

      <% if (viewer?.is_admin) { %>
        <dialog class="transaction-bulk-dialog" data-bulk-edit-dialog aria-labelledby="transaction-bulk-heading">
          <form class="transaction-bulk-dialog__panel" data-bulk-edit-form>
            <header class="transaction-bulk-dialog__heading">
              <div>
                <p class="card-kicker">One-time edit</p>
                <h2 id="transaction-bulk-heading">Edit <span data-bulk-dialog-count>0</span> transactions</h2>
                <p>Only checked fields change on the selected transactions. No automatic cleanup rule is created; provider data stays untouched.</p>
              </div>
              <button class="icon-button" type="button" data-bulk-edit-close aria-label="Close bulk editor">
                <i class="ph ph-x" aria-hidden="true"></i>
              </button>
            </header>

            <fieldset class="transaction-bulk-fields">
              <legend>Fields to override</legend>

              <label class="cleanup-edit-field">
                <span class="cleanup-edit-field__toggle">
                  <input type="checkbox" data-bulk-change="display_name">
                  Merchant name
                </span>
                <input type="text" maxlength="160" placeholder="Clean merchant name" disabled data-bulk-display-name>
              </label>

              <label class="cleanup-edit-field">
                <span class="cleanup-edit-field__toggle">
                  <input type="checkbox" data-bulk-change="category_primary">
                  Category
                </span>
                <select disabled data-bulk-category>
                  <% categories.forEach((category) => { %>
                    <option value="<%= category.label %>"><%= category.label %></option>
                  <% }) %>
                </select>
              </label>

              <label class="cleanup-edit-field">
                <span class="cleanup-edit-field__toggle">
                  <input type="checkbox" data-bulk-change="tags">
                  Tags
                </span>
                <input type="text" maxlength="400" placeholder="household, reimbursable" disabled data-bulk-tags>
                <small>Comma-separated. Leave empty to clear tags.</small>
              </label>

              <label class="cleanup-edit-field">
                <span class="cleanup-edit-field__toggle">
                  <input type="checkbox" data-bulk-change="excluded_from_spending">
                  Spending treatment
                </span>
                <select disabled data-bulk-excluded>
                  <option value="false">Include in spending</option>
                  <option value="true">Exclude from spending</option>
                </select>
              </label>

              <label class="cleanup-edit-field">
                <span class="cleanup-edit-field__toggle">
                  <input type="checkbox" data-bulk-change="budget_month_offset">
                  Apply to Plan month
                </span>
                <select disabled data-bulk-budget-month>
                  <option value="-1">Previous month</option>
                  <option value="0">Posted month</option>
                  <option value="1">Next month</option>
                </select>
                <small>Relative to each selected transaction’s posted month.</small>
              </label>

            </fieldset>

            <footer class="transaction-bulk-dialog__footer">
              <span class="form-status" role="status" data-bulk-edit-status></span>
              <div>
                <button class="button button--ghost" type="button" data-bulk-edit-close>Cancel</button>
                <button class="button button--dark" type="submit" data-bulk-edit-submit disabled>Save changes</button>
              </div>
            </footer>
          </form>
        </dialog>
      <% } %>
    </section>
  </main>
  <%- include("partials/footer") %>
