<%
  const showLifecycle =
    typeof lifecycleControls !== "undefined" && lifecycleControls;
  const compact = typeof compactInsight !== "undefined" && compactInsight;
  const selectable =
    typeof bulkSelectable !== "undefined" &&
    bulkSelectable &&
    viewer?.is_admin;
  const state = insight.state || "active";
  const returnView =
    typeof insightView !== "undefined" && insightView === "archive"
      ? "archive"
      : "active";
%>
<article
  class="insight-card insight-card--<%= insight.severity %><%= compact ? ' insight-card--compact' : '' %>"
  data-insight-card
  data-finding-id="<%= insight.id %>"
  <% if (selectable) { %>data-bulk-insight-card<% } %>
>
  <% if (selectable) { %>
    <label class="insight-select-control" hidden>
      <input
        type="checkbox"
        value="<%= insight.id %>"
        data-insight-select
        data-insight-family="<%= insight.family %>"
      >
      <span class="sr-only">Select <%= insight.actionTitle || insight.title %></span>
    </label>
  <% } %>
  <h3><%= insight.actionTitle || insight.title %></h3>
  <% if (insight.timeframe) { %>
    <p class="insight-timeframe"><%= insight.timeframe %></p>
  <% } %>
  <p class="insight-card__detail"><%= insight.detail || insight.copy %></p>

  <div class="insight-card__actions">
    <% if (insight.solveAction?.webUrl) { %>
      <a class="button button--secondary insight-card__solve" href="<%= insight.solveAction.webUrl %>">
        <%= insight.solveAction.label %>
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    <% } else { %>
      <a class="button button--secondary insight-card__solve" href="/insights?finding=<%= encodeURIComponent(insight.id) %>">
        See what changed
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    <% } %>

    <% if (showLifecycle) { %>
      <% if (returnView === "archive") { %>
        <span class="insight-lifecycle-label"><%= insight.lifecycleLabel %></span>
      <% } %>
      <% if (viewer?.is_admin) { %>
        <details class="insight-card__menu">
          <summary class="button button--ghost insight-card__menu-trigger" aria-label="Actions for <%= insight.actionTitle || insight.title %>">
            Actions
            <i class="ph ph-caret-down" aria-hidden="true"></i>
          </summary>
          <div class="insight-card__menu-panel">
            <% if (state === "active") { %>
              <button type="button" data-insight-action="archive" data-finding-id="<%= insight.id %>">
                <i class="ph ph-archive" aria-hidden="true"></i>
                Archive
              </button>
              <button type="button" data-insight-action="ignore" data-finding-id="<%= insight.id %>">
                <i class="ph ph-eye-slash" aria-hidden="true"></i>
                Ignore similar
              </button>
              <% if (insight.family === "subscriptions") { %>
                <button type="button" data-insight-action="report_incorrect" data-reason-code="not_subscription" data-finding-id="<%= insight.id %>">
                  <i class="ph ph-x-circle" aria-hidden="true"></i>
                  Not a subscription
                </button>
              <% } %>
              <button type="button" data-insight-action="report_incorrect" data-reason-code="wrong_data" data-finding-id="<%= insight.id %>">
                <i class="ph ph-warning" aria-hidden="true"></i>
                Incorrect data
              </button>
              <button type="button" data-insight-action="report_incorrect" data-reason-code="wrong_interpretation" data-finding-id="<%= insight.id %>">
                <i class="ph ph-brain" aria-hidden="true"></i>
                Wrong interpretation
              </button>
              <button type="button" data-insight-action="report_incorrect" data-reason-code="other_false_positive" data-finding-id="<%= insight.id %>">
                <i class="ph ph-thumbs-down" aria-hidden="true"></i>
                Other false positive
              </button>
            <% } else { %>
              <button type="button" data-insight-action="restore" data-finding-id="<%= insight.id %>">
                <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
                Restore
              </button>
              <% if (state !== "bad") { %>
                <button type="button" data-insight-action="report_incorrect" data-reason-code="other_false_positive" data-finding-id="<%= insight.id %>">
                  <i class="ph ph-thumbs-down" aria-hidden="true"></i>
                  Incorrect
                </button>
              <% } %>
            <% } %>
            <button
              class="danger-action"
              type="button"
              data-insight-action="delete"
              data-finding-id="<%= insight.id %>"
              data-confirm-message="Delete this insight permanently? This cannot be undone."
            >
              <i class="ph ph-trash" aria-hidden="true"></i>
              Delete
            </button>
          </div>
        </details>
      <% } %>
    <% } %>
  </div>
  <span class="save-status" role="status" aria-live="polite" data-insight-action-status></span>
</article>
