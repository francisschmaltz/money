<%
  const transactionDetailQuery = new URLSearchParams();
  for (const key of ["period", "start", "end", "q", "account", "category", "cursor"]) {
    if (query?.[key]) transactionDetailQuery.set(key, String(query[key]));
  }
  transactionDetailQuery.set("transaction", transaction.id);
%>
<a class="transaction-row" href="/transactions?<%= transactionDetailQuery.toString() %>">
  <span class="list-icon" aria-hidden="true"><i class="ph <%= transaction.icon %>"></i></span>
  <span class="transaction-row__main">
    <strong><%= transaction.merchant %></strong>
    <span
      <% if (transaction.accountId) { %>
        data-account-display-name="<%= transaction.accountId %>"
        data-account-provider-name="<%= transaction.account %>"
        data-account-prefix="<%= `${transaction.category} · ` %>"
        data-account-suffix="<%= transaction.tags?.length ? ` · ${transaction.tags.join(" · ")}` : "" %>"
      <% } %>
    ><%= transaction.category %> · <%= transaction.account %><%= transaction.tags?.length ? ` · ${transaction.tags.join(" · ")}` : "" %></span>
  </span>
  <span class="transaction-row__meta">
    <strong class="<%= transaction.amount.amount_minor > 0 ? 'money-positive' : '' %>"><%= formatMoney(transaction.amount) %></strong>
    <span><%- include("transaction-date", { transaction }) %><% if (transaction.status === "pending") { %> · Pending<% } %></span>
  </span>
</a>
