<dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-title">
  <div class="search-dialog__surface">
    <h2 class="sr-only" id="search-dialog-title">Search finances</h2>
    <div class="search-input-wrap">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      <label class="sr-only" for="global-search">Search finances</label>
      <input id="global-search" type="search" autocomplete="off" placeholder="Search transactions, accounts, subscriptions…" data-search-input>
      <label class="sr-only" for="global-search-type">Filter search results</label>
      <select id="global-search-type" data-search-entity-type aria-label="Filter search results">
        <option value="">Everything</option>
        <option value="transaction">Transactions</option>
        <option value="account">Accounts</option>
        <option value="recurring">Recurring</option>
        <option value="manual_asset">Assets</option>
        <option value="insight">Insights</option>
      </select>
      <button class="search-close" type="button" data-search-close aria-label="Close search">Esc</button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-search-dialog-status></p>
    <div class="search-dialog__body" data-search-results>
      <div class="search-empty">
        <span class="empty-icon"><i class="ph ph-command" aria-hidden="true"></i></span>
        <h2>Search everything</h2>
        <p>Try “Apple,” “groceries,” or an account name.</p>
      </div>
    </div>
    <footer class="search-dialog__footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <a href="/search" data-search-full-link>Open full search <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </footer>
  </div>
</dialog>
