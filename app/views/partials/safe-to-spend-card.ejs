<section class="card safe-to-spend-hero <%= safeToSpend.safe_to_spend.amount_minor < 0 ? 'safe-to-spend-hero--negative' : '' %>" aria-labelledby="safe-to-spend-heading">
  <div>
    <div class="safe-to-spend-title-row">
      <h2 id="safe-to-spend-heading">Safe to Spend</h2>
      <details class="safe-to-spend-help">
        <summary>
          <i class="ph ph-info" aria-hidden="true"></i>
          <span class="sr-only">How Safe to Spend is calculated</span>
        </summary>
        <p>What’s left in checking and savings after current card balances, the next monthly bills plus other bills due within 30 days, and cash set aside for goals. Bill amounts and dates are estimates based on recurring history.</p>
      </details>
    </div>
    <p class="display-money"><%= formatMoney(safeToSpend.safe_to_spend) %></p>
    <p class="card-note"><%= safeToSpend.formula %></p>
  </div>
  <dl class="safe-to-spend-breakdown" aria-label="Safe to Spend calculation">
    <div><dt>Liquid cash</dt><dd><%= formatMoney(safeToSpend.liquid_cash) %></dd></div>
    <div><dt>Credit card balances</dt><dd>− <%= formatMoney(safeToSpend.current_card_liabilities) %></dd></div>
    <div><dt>Expected bills</dt><dd>− <%= formatMoney(safeToSpend.expected_bills) %></dd></div>
    <div><dt>Goals</dt><dd>− <%= formatMoney(safeToSpend.cash_goal_earmarks) %></dd></div>
  </dl>
</section>
