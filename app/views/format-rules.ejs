<%- include("partials/head", { pageTitle }) %>
<body data-page="format-rules">
  <%- include("partials/site-header", { activePath, viewer }) %>
  <%
    const configuredFixed =
      typeof fixedCategories !== "undefined"
        ? fixedCategories
        : ["Housing", "Utilities"];
    const availableCategories =
      typeof observedCategories !== "undefined"
        ? observedCategories
        : ["Housing", "Utilities", "Groceries", "Dining", "Travel"];
    const classificationCategories = [...new Set([
      ...availableCategories,
      ...configuredFixed,
      "Other",
    ])];
    const settingsCategories =
      typeof spendingCategories !== "undefined" &&
      Array.isArray(spendingCategories)
        ? spendingCategories
        : classificationCategories.map((label, index) => ({
            id: `legacy-category-${index}`,
            name: label,
            path: label,
            depth: 0,
            classification: configuredFixed.includes(label)
              ? "fixed"
              : "flexible",
            parent_category_id: null,
            version: 1,
            transaction_count: 0,
            budget_line_count: 0,
            aliases: [],
            is_system: label === "Other",
          }));
    const activeSettingsCategories = settingsCategories
      .filter((category) => !category.status || category.status === "active")
      .sort((left, right) => {
        const leftIsOther = left.is_system || left.path === "Other";
        const rightIsOther = right.is_system || right.path === "Other";
        if (leftIsOther !== rightIsOther) return leftIsOther ? 1 : -1;
        return left.path.localeCompare(right.path);
      });
    const mergedSettingsCategories = settingsCategories.filter(
      (category) => category.status === "merged"
    );
    const settingsCategoryById = new Map(
      settingsCategories.map((category) => [category.id, category])
    );
    const cleanup =
      typeof transactionCleanup !== "undefined" && transactionCleanup
        ? transactionCleanup
        : { query: "", anchor: null, matches: [], available_tags: [] };
    const cleanupRows = [
      ...(cleanup.anchor ? [cleanup.anchor] : []),
      ...(cleanup.matches || []).filter(
        (match) => !cleanup.anchor || match.id !== cleanup.anchor.id
      ),
    ];
    const cleanupSource = cleanup.anchor || cleanupRows[0] || null;
    const cleanupCategories = [...new Set([
      cleanupSource?.category_primary,
      ...activeSettingsCategories.map((category) => category.path),
    ].filter(Boolean))];
    const cleanupTagOptions = [...new Set([
      ...(cleanup.available_tags || []),
      ...(
        typeof transactionTags !== "undefined"
          ? transactionTags.map(
              (tag) => typeof tag === "string" ? tag : tag.name
            )
          : []
      ),
    ].filter(Boolean))].sort((left, right) => left.localeCompare(right));
    const settingsTransactionRules =
      typeof transactionRules !== "undefined" &&
      Array.isArray(transactionRules)
        ? transactionRules
        : [];
    const cleanupRuleMatcherLabel = (rule) =>
      rule.matcher?.field === "normalized_name"
        ? "Transaction name"
        : "Merchant";
    const cleanupRuleMatcherMode = (rule) =>
      rule.matcher?.mode === "contains" ? "contains" : "exactly";
    const cleanupRuleChanges = (rule) => [
      rule.changes?.display_name
        ? `Rename to ${rule.changes.display_name}`
        : null,
      rule.changes?.category_primary || null,
      rule.changes?.cash_flow_role
        ? `Cash-flow role: ${rule.changes.cash_flow_role}`
        : null,
      Object.hasOwn(rule.changes || {}, "tags")
        ? rule.changes.tags.length
          ? rule.changes.tags.join(" · ")
          : "Clear tags"
        : null,
    ].filter(Boolean);
    const selectedFormatRulesSection =
      typeof formatRulesSection !== "undefined" &&
      formatRulesSection === "categories"
        ? "categories"
        : "rules";
  %>
  <main class="page-shell page-shell--settings">
    <%- include("partials/page-heading", {
      eyebrow: "Administrator",
      pageTitle,
      actionLabel: null,
      actionHref: null,
      actionIcon: null
    }) %>

    <nav class="settings-nav format-rules-nav" aria-label="Format Rules sections">
      <a href="/format-rules" <%- selectedFormatRulesSection === "rules" ? 'aria-current="page"' : "" %>>Rules</a>
      <a href="/format-rules/categories" <%- selectedFormatRulesSection === "categories" ? 'aria-current="page"' : "" %>>Categories</a>
    </nav>

    <% if (selectedFormatRulesSection === "rules") { %>
      <div
        data-transaction-cleanup
        data-cleanup-source-merchant="<%= cleanupSource?.raw_merchant || '' %>"
        data-cleanup-source-name="<%= cleanupSource?.raw_name || '' %>"
      >
        <%- include("partials/format-rules-list", {
          settingsTransactionRules,
          cleanupRuleChanges,
          cleanupRuleMatcherLabel,
          cleanupRuleMatcherMode,
          cleanupCategories,
          cleanupTagOptions
        }) %>
        <%- include("partials/format-rules-transaction-cleanup", {
          cleanup,
          cleanupRows,
          cleanupSource,
          cleanupCategories,
          cleanupTagOptions
        }) %>
        <section class="card settings-card cleanup-rerun">
          <div>
            <h2>Re-run every rule</h2>
            <p>Apply every enabled format rule to all posted transactions, then rebuild search and insights.</p>
          </div>
          <div class="cleanup-rerun__action">
            <span class="save-status" role="status" data-cleanup-rerun-status></span>
            <button class="button button--dark" type="button" data-cleanup-rerun>Re-Run All</button>
          </div>
        </section>
      </div>
    <% } else { %>
      <%- include("partials/format-rules-categories", {
        activeSettingsCategories,
        mergedSettingsCategories,
        settingsCategoryById
      }) %>
    <% } %>
  </main>
  <%- include("partials/footer") %>
