<%- include("partials/head", { pageTitle }) %>
<body data-page="plan">
  <%- include("partials/site-header", { activePath, viewer }) %>
  <%
    const editBudget = String(query.edit_budget || "") === "1";
    const budgetViewHref = "/plan#budget";
    const budgetEditHref = "/plan?edit_budget=1#budget";
    const priorBudget =
      typeof previousBudget !== "undefined" && previousBudget
        ? previousBudget
        : {
            lines: [],
            actual_total: {
              amount_minor: 0,
              currency: budget.actual_total.currency,
            },
          };
    const previousActualByCategory = new Map(
      priorBudget.lines.flatMap((line) => [
        [line.category_id, line.actual],
        [line.category, line.actual],
      ]),
    );
    const zeroBudgetMoney = {
      amount_minor: 0,
      currency: budget.actual_total.currency,
    };
    const budgetedCategoryIds = new Set(
      budget.lines.map((line) => line.category_id),
    );
    const budgetParentIds = new Set(
      budget.lines
        .map((line) => line.parent_category_id)
        .filter(Boolean),
    );
    const incomeCategoryIds = new Set(
      budget.income_category_ids || [],
    );
    const budgetCategoriesById = new Map(
      (budget.available_categories || []).map(
        (category) => [category.id, category],
      ),
    );
    const isInsideCategoryRoots = (categoryId, rootIds) => {
      let current = budgetCategoriesById.get(categoryId);
      const visited = new Set();
      while (current && !visited.has(current.id)) {
        if (rootIds.has(current.id)) return true;
        visited.add(current.id);
        current = budgetCategoriesById.get(
          current.parent_category_id,
        );
      }
      return false;
    };
    const containsCategoryRoot = (categoryId, rootIds) =>
      [...rootIds].some((rootId) =>
        isInsideCategoryRoots(rootId, new Set([categoryId])),
      );
    const availableBudgetCategories = (
      budget.available_categories || []
    ).filter(
      (category) =>
        !budgetedCategoryIds.has(category.id) &&
        !isInsideCategoryRoots(category.id, incomeCategoryIds) &&
        !containsCategoryRoot(category.id, incomeCategoryIds) &&
        (
          !category.parent_category_id ||
          budgetedCategoryIds.has(category.parent_category_id)
        ),
    );
    const availableIncomeCategories = (
      budget.available_categories || []
    ).filter(
      (category) =>
        !isInsideCategoryRoots(category.id, budgetedCategoryIds) &&
        !containsCategoryRoot(category.id, budgetedCategoryIds),
    );
    const remainingStatus = (remaining) =>
      remaining.amount_minor < 0
        ? `${formatMoney({
            amount_minor: Math.abs(remaining.amount_minor),
            currency: remaining.currency,
          })} over`
        : remaining.amount_minor > 0
          ? `${formatMoney(remaining)} under`
          : "On budget";
    const remainingClass = (remaining) =>
      remaining.amount_minor < 0
        ? "budget-status--over"
        : remaining.amount_minor > 0
          ? "budget-status--under"
          : "budget-status--even";
    const percent = (basisPoints) =>
      `${Math.max(0, Number(basisPoints || 0) / 100).toFixed(0)}%`;
    const progressValue = (basisPoints) =>
      Math.max(
        0,
        Math.min(100, Number(basisPoints || 0) / 100),
      ).toFixed(0);
    const goalPurposes = [
      ["vacation", "Vacation"],
      ["home", "Home"],
      ["vehicle", "Vehicle"],
      ["education", "Education"],
      ["emergency", "Emergency"],
      ["event", "Event"],
      ["purchase", "Purchase"],
      ["other", "Other"],
    ];
    const goalPurposeLabels = new Map(goalPurposes);
    const goalPurpose = (purpose) =>
      goalPurposeLabels.has(purpose) ? purpose : "other";
    const goalPurposeLabel = (purpose) =>
      goalPurposeLabels.get(goalPurpose(purpose));
    const goalMoney = (value, amountMinor = 0, currency = "USD") =>
      value && Number.isFinite(Number(value.amount_minor))
        ? value
        : {
            amount_minor: Number(amountMinor) || 0,
            currency,
          };
    const goalPlanned = (goal) =>
      goalMoney(
        goal.planned,
        goal.target_amount_minor,
        goal.currency_code,
      );
    const goalActual = (goal) =>
      goalMoney(
        goal.actual,
        goal.spent?.amount_minor,
        goal.currency_code,
      );
    const goalPlanRemaining = (goal) =>
      goalMoney(goal.plan_remaining, 0, goal.currency_code);
    const goalUsageBasisPoints = (goal) => {
      if (
        goal.used_basis_points != null &&
        Number.isFinite(Number(goal.used_basis_points))
      ) {
        return Math.max(0, Number(goal.used_basis_points));
      }
      return 0;
    };
    const goalUsagePercent = (goal) =>
      `${(goalUsageBasisPoints(goal) / 100).toLocaleString(undefined, {
        minimumFractionDigits: 0,
        maximumFractionDigits: 1,
      })}%`;
    const goalOverAmount = (goal) => {
      const overBy = goalMoney(goal.over_by, 0, goal.currency_code);
      return {
        ...overBy,
        amount_minor: Math.max(0, overBy.amount_minor),
      };
    };
    const goalUnusedAmount = (goal) => {
      const remaining = goalPlanRemaining(goal);
      return {
        amount_minor: Math.max(0, remaining.amount_minor),
        currency: remaining.currency || goal.currency_code || "USD",
      };
    };
    const finishedGoals =
      typeof archivedGoals !== "undefined" && Array.isArray(archivedGoals)
        ? archivedGoals
        : [];
    const goalHistoryInsights =
      typeof historyInsights !== "undefined" && Array.isArray(historyInsights)
        ? historyInsights
        : [];
    const finishedDateLabel = (value) => {
      if (!value) return "Finish date unavailable";
      const date = new Date(value);
      return Number.isNaN(date.getTime())
        ? `Finished ${value}`
        : `Finished ${date.toLocaleDateString(undefined, {
            year: "numeric",
            month: "short",
            day: "numeric",
          })}`;
    };
    const variancePercent = (basisPoints) => {
      const value = Math.abs(Number(basisPoints) || 0) / 100;
      return Number.isInteger(value) ? value.toFixed(0) : value.toFixed(1);
    };
    const historyInsightCopy = (insight) => {
      if (insight.copy) return insight.copy;
      if (insight.kind !== "purpose_actual_variance") return "";
      const count = Number(insight.completed_goal_count) || 0;
      const variance = Number(insight.median_actual_variance_basis_points) || 0;
      const purpose = goalPurposeLabel(insight.purpose).toLowerCase();
      if (count < 2) {
        if (variance === 0) {
          return `Your finished ${purpose} goal landed on plan.`;
        }
        return `Your finished ${purpose} goal was ${variancePercent(variance)}% ${variance > 0 ? "over" : "under"} plan.`;
      }
      if (variance === 0) {
        return `You tend to land right on plan for ${purpose} goals.`;
      }
      return `You tend to spend ${variancePercent(variance)}% ${variance > 0 ? "more" : "less"} on ${purpose} goals than planned.`;
    };
  %>
  <main class="page-shell">
    <%- include("partials/page-heading", {
      eyebrow: freshness ? `Balances through ${new Date(freshness).toLocaleString()}` : "Family plan",
      pageTitle,
      actionLabel: "View accounts",
      actionHref: "/accounts",
      actionIcon: "ph-bank"
    }) %>

    <%- include("partials/safe-to-spend-card", { safeToSpend }) %>

    <dl class="card plan-source-strip" aria-label="Taxable brokerage goal backing">
      <div><dt>Taxable brokerage</dt><dd><%= formatMoney(safeToSpend.taxable_brokerage_value) %></dd></div>
      <div><dt>Goal earmarks</dt><dd><%= formatMoney(safeToSpend.brokerage_goal_earmarks) %></dd></div>
      <div><dt>Effectively backed</dt><dd><%= formatMoney(safeToSpend.brokerage_goal_backed_value) %></dd></div>
      <div><dt>Unallocated</dt><dd><%= formatMoney(safeToSpend.brokerage_unallocated_value) %></dd></div>
      <div><dt>Backing ratio</dt><dd><%= percent(safeToSpend.brokerage_backing_basis_points) %></dd></div>
    </dl>

    <% if (alerts.length) { %>
      <section class="plan-alerts" aria-label="Planning alerts">
        <% alerts.forEach((alert) => { %>
          <article class="plan-alert">
            <i class="ph ph-warning-circle" aria-hidden="true"></i>
            <div><strong><%= alert.code.replaceAll("_", " ") %></strong><p><%= alert.message %></p></div>
          </article>
        <% }) %>
      </section>
    <% } %>

    <section id="goals" class="plan-section" aria-labelledby="goals-heading">
      <div class="section-heading">
        <div><p class="card-kicker">Shared household</p><h2 id="goals-heading">Goals</h2></div>
        <div class="goal-section__actions">
          <p><%= goals.length %> active</p>
          <button
            class="button button--dark"
            type="button"
            data-goal-dialog-open="create"
            data-goal-dialog-target="goal-create-dialog"
          >
            <i class="ph ph-plus" aria-hidden="true"></i>
            New goal
          </button>
        </div>
      </div>
      <div class="goal-grid">
        <% goals.forEach((goal, goalIndex) => { const schedule = goal.schedules?.[0]; const usageBasisPoints = goalUsageBasisPoints(goal); const overAmount = goalOverAmount(goal); const overPlan = usageBasisPoints > 10_000 || overAmount.amount_minor > 0; const planBalance = goalUnusedAmount(goal); const unfundedSpend = goalMoney(goal.unfunded_spend, 0, goal.currency_code); %>
          <article class="card goal-card">
            <div class="goal-card__heading">
              <div>
                <h3><%= goal.name %></h3>
                <p><%= goalPurposeLabel(goal.purpose) %> · <%= goal.target_on ? `Target ${goal.target_on}` : "No target date" %></p>
              </div>
              <strong><%= percent(goal.progress_basis_points) %> funded</strong>
            </div>
            <div
              class="plan-progress"
              role="progressbar"
              aria-label="<%= goal.name %> funding progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="<%= progressValue(goal.progress_basis_points) %>"
            >
              <span style="width: <%= Math.min(100, goal.progress_basis_points / 100) %>%"></span>
            </div>
            <div class="goal-card__money">
              <strong><%= formatMoney(goal.funded) %></strong>
              <span>of <%= formatMoney({ amount_minor: goal.target_amount_minor, currency: goal.currency_code }) %></span>
            </div>
            <dl class="goal-plan-summary" aria-label="<%= goal.name %> spending plan">
              <div><dt>Planned</dt><dd><%= formatMoney(goalPlanned(goal)) %></dd></div>
              <div><dt>Actual</dt><dd><%= formatMoney(goalActual(goal)) %></dd></div>
              <div class="<%= overPlan ? 'goal-plan-summary__usage--over' : '' %>">
                <dt>Usage</dt>
                <dd><%= goalUsagePercent(goal) %></dd>
              </div>
              <div>
                <dt>Remaining</dt>
                <dd><%= formatMoney(planBalance) %></dd>
              </div>
            </dl>
            <% if (overPlan) { %>
              <p class="goal-plan-overage"><span>Over by</span><strong><%= formatMoney(overAmount) %></strong></p>
            <% } %>
            <dl class="goal-composition">
              <div><dt>Cash</dt><dd><%= formatMoney(goal.cash_earmarked) %></dd></div>
              <div><dt>Brokerage earmark</dt><dd><%= formatMoney(goal.brokerage_earmarked) %></dd></div>
              <div><dt>Brokerage backed now</dt><dd><%= formatMoney(goal.brokerage_backed) %></dd></div>
              <div><dt>Spent</dt><dd><%= formatMoney(goal.spent || { amount_minor: 0, currency: goal.currency_code }) %></dd></div>
              <div><dt>Still needed</dt><dd><%= formatMoney(goal.shortfall) %></dd></div>
              <% if (unfundedSpend.amount_minor > 0) { %>
                <div class="goal-composition__warning"><dt>Unfunded spending</dt><dd><%= formatMoney(unfundedSpend) %></dd></div>
              <% } %>
              <div>
                <dt>Automatic funding</dt>
                <dd>
                  <% if (schedule) { %>
                    <%= formatMoney({ amount_minor: schedule.amount_minor, currency: goal.currency_code }) %>
                    <%= schedule.cadence === "biweekly_friday" ? "every other Friday" : `monthly on day ${schedule.monthly_day}` %><%= schedule.status === "paused" ? " · paused" : "" %>
                  <% } else { %>
                    Not set
                  <% } %>
                </dd>
              </div>
            </dl>

            <div class="goal-card__actions">
              <button
                class="button button--secondary"
                type="button"
                data-goal-dialog-open="edit"
                data-goal-dialog-target="goal-edit-dialog-<%= goalIndex %>"
                aria-label="Edit <%= goal.name %>"
              >
                <i class="ph ph-pencil-simple" aria-hidden="true"></i>
                Edit
              </button>
              <button
                class="button button--dark"
                type="button"
                data-goal-dialog-open="allocate"
                data-goal-dialog-target="goal-allocate-dialog-<%= goalIndex %>"
                aria-label="Move money for <%= goal.name %>"
              >
                <i class="ph ph-arrows-left-right" aria-hidden="true"></i>
                Move money
              </button>
            </div>
          </article>

          <dialog
            data-goal-dialog="edit"
            id="goal-edit-dialog-<%= goalIndex %>"
            class="plan-dialog"
            aria-labelledby="goal-edit-dialog-title-<%= goalIndex %>"
          >
            <div class="plan-dialog__surface">
              <header class="plan-dialog__heading">
                <div>
                  <p class="card-kicker">Goal settings</p>
                  <h3 id="goal-edit-dialog-title-<%= goalIndex %>">Edit <%= goal.name %></h3>
                </div>
                <button class="icon-button" type="button" data-goal-dialog-close aria-label="Close edit goal">
                  <i class="ph ph-x" aria-hidden="true"></i>
                </button>
              </header>
              <div class="plan-dialog__scroll">
                <form
                  id="goal-edit-form-<%= goalIndex %>"
                  class="plan-dialog__body plan-form-grid"
                  data-plan-form
                  data-endpoint="/api/v1/plan/goals/<%= encodeURIComponent(goal.id) %>"
                  data-method="PUT"
                >
                  <input type="hidden" name="expected_version" value="<%= goal.version %>">
                  <label>Name<input name="name" maxlength="120" value="<%= goal.name %>" required data-goal-dialog-initial-focus></label>
                  <label>Purpose
                    <select name="purpose" required>
                      <% goalPurposes.forEach(([value, label]) => { %>
                        <option value="<%= value %>" <%= goalPurpose(goal.purpose) === value ? "selected" : "" %>><%= label %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label>Target amount<span class="money-input"><span>$</span><input data-money-minor="target_amount_minor" inputmode="decimal" value="<%= (goal.target_amount_minor / 100).toFixed(2) %>" required></span></label>
                  <label>Target date <span class="optional">optional</span><input name="target_on" type="date" value="<%= goal.target_on || "" %>" data-null-when-empty></label>
                  <span class="form-status" data-plan-status aria-live="polite"></span>
                </form>
                <details class="plan-dialog__schedule">
                  <summary><i class="ph ph-calendar-dots" aria-hidden="true"></i> <%= schedule ? "Edit automatic funding" : "Add automatic funding" %></summary>
                  <form class="plan-form-grid" data-plan-form data-endpoint="/api/v1/plan/goals/<%= encodeURIComponent(goal.id) %>/schedule" data-method="PUT">
                    <% if (schedule) { %><input type="hidden" name="schedule_id" value="<%= schedule.id %>"><% } %>
                    <input type="hidden" name="expected_version" value="<%= schedule?.version || 1 %>">
                    <label>Source
                      <select name="source"><option value="cash" <%= schedule?.source === "cash" ? "selected" : "" %>>Cash</option><option value="brokerage" <%= schedule?.source === "brokerage" ? "selected" : "" %>>Brokerage</option></select>
                    </label>
                    <label>Cadence
                      <select name="cadence"><option value="monthly" <%= schedule?.cadence === "monthly" ? "selected" : "" %>>Monthly</option><option value="biweekly_friday" <%= schedule?.cadence === "biweekly_friday" ? "selected" : "" %>>Every other Friday</option></select>
                    </label>
                    <label>Amount
                      <span class="money-input"><span>$</span><input data-money-minor="amount_minor" inputmode="decimal" value="<%= ((schedule?.amount_minor || 10000) / 100).toFixed(2) %>" required></span>
                    </label>
                    <label>Monthly day
                      <input name="monthly_day" type="number" min="1" max="31" value="<%= schedule?.monthly_day || 1 %>">
                    </label>
                    <label>Friday anchor
                      <input name="anchor_on" type="date" value="<%= schedule?.anchor_on || "" %>">
                    </label>
                    <label>Status
                      <select name="status"><option value="active" <%= schedule?.status !== "paused" ? "selected" : "" %>>Active</option><option value="paused" <%= schedule?.status === "paused" ? "selected" : "" %>>Paused</option></select>
                    </label>
                    <button class="button button--secondary" type="submit">Save schedule</button>
                    <span class="form-status" data-plan-status aria-live="polite"></span>
                  </form>
                </details>
              </div>
              <footer class="plan-dialog__footer">
                <div class="plan-dialog__finish">
                  <form data-plan-form data-endpoint="/api/v1/plan/goals/<%= encodeURIComponent(goal.id) %>/finish" data-method="POST">
                    <input type="hidden" name="expected_version" value="<%= goal.version %>">
                    <label>
                      Outcome
                      <select name="outcome" aria-label="Outcome for <%= goal.name %>">
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                      </select>
                    </label>
                    <button class="button button--ghost" type="submit">Finish goal</button>
                    <span class="form-status" data-plan-status aria-live="polite"></span>
                  </form>
                </div>
                <div class="plan-dialog__footer-actions">
                  <button class="button button--secondary" type="button" data-goal-dialog-close>Cancel</button>
                  <button class="button button--dark" type="submit" form="goal-edit-form-<%= goalIndex %>">Save goal</button>
                </div>
              </footer>
            </div>
          </dialog>

          <dialog
            data-goal-dialog="allocate"
            id="goal-allocate-dialog-<%= goalIndex %>"
            class="plan-dialog"
            aria-labelledby="goal-allocate-dialog-title-<%= goalIndex %>"
          >
            <form
              class="plan-dialog__surface"
              data-plan-form
              data-plan-idempotent
              data-endpoint="/api/v1/plan/goals/<%= encodeURIComponent(goal.id) %>/allocations"
              data-method="POST"
            >
              <header class="plan-dialog__heading">
                <div>
                  <p class="card-kicker">Goal funding</p>
                  <h3 id="goal-allocate-dialog-title-<%= goalIndex %>">Move money for <%= goal.name %></h3>
                </div>
                <button class="icon-button" type="button" data-goal-dialog-close aria-label="Close goal funding">
                  <i class="ph ph-x" aria-hidden="true"></i>
                </button>
              </header>
              <div class="plan-dialog__body plan-form-grid">
                <input type="hidden" name="expected_version" value="<%= goal.version %>">
                <dl class="plan-dialog__funding-summary" aria-label="Current goal funding">
                  <div><dt>Cash</dt><dd><%= formatMoney(goal.cash_earmarked) %></dd></div>
                  <div><dt>Brokerage</dt><dd><%= formatMoney(goal.brokerage_earmarked) %></dd></div>
                  <div><dt>Still needed</dt><dd><%= formatMoney(goal.shortfall) %></dd></div>
                </dl>
                <label>Move
                  <select name="direction" data-goal-dialog-initial-focus><option value="allocate">Allocate</option><option value="release">Release</option></select>
                </label>
                <label>From
                  <select name="source"><option value="cash">Cash</option><option value="brokerage">Brokerage</option></select>
                </label>
                <label>Amount
                  <span class="money-input"><span>$</span><input data-money-minor="amount_minor" inputmode="decimal" value="100.00" required></span>
                </label>
              </div>
              <footer class="plan-dialog__footer">
                <span class="form-status" data-plan-status aria-live="polite"></span>
                <div class="plan-dialog__footer-actions">
                  <button class="button button--secondary" type="button" data-goal-dialog-close>Cancel</button>
                  <button class="button button--dark" type="submit">Update funding</button>
                </div>
              </footer>
            </form>
          </dialog>
        <% }) %>
      </div>

      <dialog
        id="goal-create-dialog"
        class="plan-dialog"
        data-goal-dialog="create"
        aria-labelledby="goal-create-dialog-title"
      >
        <form class="plan-dialog__surface" data-plan-form data-endpoint="/api/v1/plan/goals" data-method="POST">
          <header class="plan-dialog__heading">
            <div>
              <p class="card-kicker">Shared household</p>
              <h3 id="goal-create-dialog-title">New goal</h3>
            </div>
            <button class="icon-button" type="button" data-goal-dialog-close aria-label="Close new goal">
              <i class="ph ph-x" aria-hidden="true"></i>
            </button>
          </header>
          <div class="plan-dialog__body plan-form-grid">
            <label>Name<input name="name" maxlength="120" required data-goal-dialog-initial-focus></label>
            <label>Purpose
              <select name="purpose" required>
                <% goalPurposes.forEach(([value, label]) => { %>
                  <option value="<%= value %>" <%= value === "other" ? "selected" : "" %>><%= label %></option>
                <% }) %>
              </select>
            </label>
            <label>Target amount<span class="money-input"><span>$</span><input data-money-minor="target_amount_minor" inputmode="decimal" required></span></label>
            <label>Target date <span class="optional">optional</span><input name="target_on" type="date"></label>
          </div>
          <footer class="plan-dialog__footer">
            <span class="form-status" data-plan-status aria-live="polite"></span>
            <div class="plan-dialog__footer-actions">
              <button class="button button--secondary" type="button" data-goal-dialog-close>Cancel</button>
              <button class="button button--dark" type="submit">Create goal</button>
            </div>
          </footer>
        </form>
      </dialog>
    </section>

    <% if (finishedGoals.length || goalHistoryInsights.length) { %>
      <details class="card plan-section finished-goals" aria-labelledby="finished-goals-heading">
        <summary>
          <span>
            <strong id="finished-goals-heading">Finished goals</strong>
            <small><%= finishedGoals.length %> <%= finishedGoals.length === 1 ? "goal" : "goals" %></small>
          </span>
          <i class="ph ph-caret-down" aria-hidden="true"></i>
        </summary>
        <div class="finished-goals__body">
          <% if (goalHistoryInsights.length) { %>
            <div class="goal-history-insights" aria-label="Goal history insights">
              <% goalHistoryInsights.forEach((insight) => { const copy = historyInsightCopy(insight); %>
                <% if (copy) { %>
                  <p><i class="ph ph-chart-line-up" aria-hidden="true"></i><span><%= copy %></span></p>
                <% } %>
              <% }) %>
            </div>
          <% } %>
          <div class="finished-goals__grid">
            <% finishedGoals.forEach((goal) => { const usageBasisPoints = goalUsageBasisPoints(goal); const overAmount = goalOverAmount(goal); const overPlan = usageBasisPoints > 10_000 || overAmount.amount_minor > 0; const unusedAmount = goalUnusedAmount(goal); %>
              <article class="finished-goal-card">
                <header>
                  <div>
                    <h3><%= goal.name %></h3>
                    <p><%= goalPurposeLabel(goal.purpose) %> · <%= finishedDateLabel(goal.archived_at) %></p>
                  </div>
                  <span class="goal-outcome goal-outcome--<%= goal.archive_outcome === 'cancelled' ? 'cancelled' : 'completed' %>"><%= goal.archive_outcome === "cancelled" ? "Cancelled" : "Completed" %></span>
                </header>
                <dl>
                  <div><dt>Planned</dt><dd><%= formatMoney(goalPlanned(goal)) %></dd></div>
                  <div><dt>Actual</dt><dd><%= formatMoney(goalActual(goal)) %></dd></div>
                  <div class="<%= overPlan ? 'goal-plan-summary__usage--over' : '' %>">
                    <dt>Usage</dt>
                    <dd><%= goalUsagePercent(goal) %></dd>
                  </div>
                  <div>
                    <dt><%= overPlan ? "Remaining" : "Unused" %></dt>
                    <dd><%= formatMoney(unusedAmount) %></dd>
                  </div>
                </dl>
                <% if (overPlan) { %>
                  <p class="goal-plan-overage"><span>Over by</span><strong><%= formatMoney(overAmount) %></strong></p>
                <% } %>
              </article>
            <% }) %>
          </div>
        </div>
      </details>
    <% } %>

    <section id="budget" class="card plan-section budget-board" aria-labelledby="budget-heading">
      <div class="card-heading">
        <h2 id="budget-heading">Budget</h2>
        <a class="button button--secondary" href="<%= editBudget ? budgetViewHref : budgetEditHref %>"><i class="ph ph-<%= editBudget ? 'check' : 'pencil-simple' %>"></i> <%= editBudget ? "Done" : "Edit budget" %></a>
      </div>
      <div class="budget-summary" aria-label="Budget cash flow summary">
        <article>
          <span>Average monthly income</span>
          <strong><%= formatMoney(budget.average_monthly_income) %></strong>
          <small>Previous 4 completed months</small>
        </article>
        <article>
          <span>Estimated leftover</span>
          <strong><%= formatMoney(budget.estimated_leftover) %></strong>
          <small>Average income minus planned spending</small>
        </article>
        <article>
          <span>Actual leftover<%= budget.is_current_month ? " (MTD)" : "" %></span>
          <strong><%= formatMoney(budget.actual_leftover) %></strong>
          <small>All income minus all spending</small>
        </article>
        <article class="budget-summary__status budget-summary__status--<%= budget.plan_status %>">
          <span>Plan status</span>
          <strong><%= budget.plan_status === "needs_attention" ? "Needs attention" : "On track" %></strong>
          <small>Informational budgets never trigger variance</small>
        </article>
      </div>
      <% if (editBudget) { %>
        <details class="plan-disclosure">
          <summary>Add or configure categories</summary>
          <form class="plan-inline-form" data-plan-form data-endpoint="/api/v1/plan/budget" data-method="POST">
            <input type="hidden" name="expected_version" value="0">
            <label>Category
              <select name="category_id" required>
                <option value="">Choose a category</option>
                <% availableBudgetCategories.forEach((category) => { %>
                  <option value="<%= category.id %>"><%= category.path %></option>
                <% }) %>
              </select>
            </label>
            <label>Plan amount<span class="money-input"><span>$</span><input data-money-minor="amount_minor" inputmode="decimal" required></span></label>
            <label>Tracking
              <select name="tracking_mode">
                <option value="tracked">Tracked</option>
                <option value="informational">Informational</option>
              </select>
            </label>
            <button class="button button--secondary" type="submit">Add category</button>
            <span class="form-status" data-plan-status aria-live="polite"></span>
          </form>
          <form class="plan-inline-form" data-plan-form data-budget-income-form data-endpoint="/api/v1/plan/budget/settings" data-method="PUT">
            <input type="hidden" name="expected_version" value="<%= budget.settings_version || 0 %>">
            <fieldset>
              <legend>Income categories</legend>
              <% availableIncomeCategories.forEach((category) => { %>
                <label class="check-row">
                  <input type="checkbox" name="income_category_ids" value="<%= category.id %>" <%= incomeCategoryIds.has(category.id) ? "checked" : "" %>>
                  <span><%= category.path %></span>
                </label>
              <% }) %>
            </fieldset>
            <button class="button button--secondary" type="submit">Save income categories</button>
            <span class="form-status" data-plan-status aria-live="polite"></span>
          </form>
        </details>
      <% } %>
      <div class="budget-table" role="table" aria-label="Budget status" tabindex="0">
        <div class="budget-row budget-row--heading <%= editBudget ? 'budget-row--edit' : 'budget-row--view' %>" role="row"><span role="columnheader">Category</span><span role="columnheader">Planned</span><span role="columnheader">Actual</span><span role="columnheader">Remaining</span><span role="columnheader">Previous month actual</span><% if (editBudget) { %><span role="columnheader"><span class="sr-only">Actions</span></span><% } %></div>
        <div class="budget-row budget-row--total <%= editBudget ? 'budget-row--edit' : 'budget-row--view' %>" role="row">
          <span role="cell">Total</span>
          <span role="cell"><%= formatMoney(budget.planned_total) %></span>
          <span role="cell"><%= formatMoney(budget.actual_total) %></span>
          <span role="cell" class="budget-status <%= remainingClass(budget.remaining_total) %>"><%= remainingStatus(budget.remaining_total) %></span>
          <span role="cell"><%= formatMoney(priorBudget.actual_total) %></span>
          <% if (editBudget) { %><span role="cell"></span><% } %>
        </div>
        <% budget.lines.forEach((line) => { %>
          <%
            const budgetStatus = line.remaining
              ? remainingStatus(line.remaining)
              : "Informational";
            const previousActual =
              previousActualByCategory.get(line.category_id) ||
              previousActualByCategory.get(line.category) ||
              zeroBudgetMoney;
          %>
          <% if (editBudget) { %>
            <form class="budget-row budget-row--edit <%= line.over.amount_minor > 0 ? 'budget-row--over' : '' %>" role="row" data-plan-form data-budget-category-id="<%= line.category_id %>" data-budget-parent-id="<%= line.parent_category_id || '' %>" data-endpoint="/api/v1/plan/budget/<%= encodeURIComponent(line.category_id) %>" data-method="PUT">
              <input type="hidden" name="expected_version" value="<%= line.version %>">
              <span role="cell" style="--budget-depth: <%= line.depth || 0 %>"><span class="budget-category-heading"><% if (budgetParentIds.has(line.category_id)) { %><button class="budget-tree-toggle" type="button" data-budget-toggle aria-expanded="true" aria-label="Collapse <%= line.category %> child budgets"><i class="ph ph-caret-down" aria-hidden="true"></i></button><% } else { %><span class="budget-tree-spacer" aria-hidden="true"></span><% } %><a class="budget-category-link" href="/transactions?category=<%= encodeURIComponent(line.category_id) %>"><%= line.name || line.category %></a></span><% if (line.effective_tracking_mode === "informational") { %><small><%= line.tracking_mode === "informational" ? "Informational" : "Informational (inherited)" %></small><% } %></span>
              <span class="money-input" role="cell"><span>$</span><input data-money-minor="amount_minor" inputmode="decimal" value="<%= (line.planned.amount_minor / 100).toFixed(2) %>" aria-label="<%= line.category %> planned amount"></span>
              <span role="cell"><%= formatMoney(line.actual) %></span>
              <span role="cell" class="budget-status <%= line.remaining ? remainingClass(line.remaining) : '' %>"><%= line.remaining ? budgetStatus : "Informational" %></span>
              <span role="cell"><%= formatMoney(previousActual) %></span>
              <span role="cell"><select name="tracking_mode" aria-label="<%= line.category %> tracking mode"><option value="tracked" <%= line.tracking_mode === "tracked" ? "selected" : "" %>>Tracked</option><option value="informational" <%= line.tracking_mode === "informational" ? "selected" : "" %>>Informational</option></select><button class="button button--ghost" type="submit">Save</button><button class="button button--ghost" type="button" data-budget-remove data-endpoint="/api/v1/plan/budget/<%= encodeURIComponent(line.category_id) %>">Remove</button><span class="form-status" data-plan-status aria-live="polite"></span></span>
            </form>
          <% } else { %>
            <div class="budget-row budget-row--view <%= line.over.amount_minor > 0 ? 'budget-row--over' : '' %>" role="row" data-budget-category-id="<%= line.category_id %>" data-budget-parent-id="<%= line.parent_category_id || '' %>">
              <span role="cell" style="--budget-depth: <%= line.depth || 0 %>"><span class="budget-category-heading"><% if (budgetParentIds.has(line.category_id)) { %><button class="budget-tree-toggle" type="button" data-budget-toggle aria-expanded="true" aria-label="Collapse <%= line.category %> child budgets"><i class="ph ph-caret-down" aria-hidden="true"></i></button><% } else { %><span class="budget-tree-spacer" aria-hidden="true"></span><% } %><a class="budget-category-link" href="/transactions?category=<%= encodeURIComponent(line.category_id) %>"><%= line.name || line.category %></a></span><% if (line.effective_tracking_mode === "informational") { %><small><%= line.tracking_mode === "informational" ? "Informational" : "Informational (inherited)" %></small><% } %></span>
              <span role="cell"><%= formatMoney(line.planned) %></span>
              <span role="cell"><%= formatMoney(line.actual) %></span>
              <span role="cell" class="budget-status <%= line.remaining ? remainingClass(line.remaining) : '' %>"><%= line.remaining ? budgetStatus : "Informational" %></span>
              <span role="cell"><%= formatMoney(previousActual) %></span>
            </div>
          <% } %>
        <% }) %>
      </div>
    </section>

    <section class="card plan-section" aria-labelledby="history-heading">
      <div class="card-heading"><div><p class="card-kicker">Append-only</p><h2 id="history-heading">Allocation and plan history</h2></div></div>
      <div class="plan-history">
        <% auditEvents.slice(0, 12).forEach((event) => { %>
          <div><i class="ph ph-clock-counter-clockwise"></i><span><strong><%= event.event_type.replaceAll(".", " ") %></strong><small><%= event.actor_type %> · <%= new Date(event.created_at).toLocaleString() %></small></span></div>
        <% }) %>
        <% if (!auditEvents.length) { %><p class="card-note">Plan changes will appear here. Unlike your memory, this log does not get creative.</p><% } %>
      </div>
    </section>
  </main>
  <%- include("partials/footer") %>
