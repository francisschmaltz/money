NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000
TRUST_PROXY=false
DEMO_MODE=true

# PostgreSQL
DATABASE_URL=postgres://money:money@127.0.0.1:5432/money
DATABASE_SSL=false

# Duo Generic OIDC SSO. Copy the issuer from Duo's Metadata tab.
# Discovery is loaded from:
#   ${DUO_OIDC_ISSUER}/.well-known/openid-configuration
# The authorization and token URLs are optional exact-match checks. Leave them
# empty to use discovery without duplicating endpoint configuration.
# AUTH_MODE=mock is rejected in production.
AUTH_MODE=mock
DUO_OIDC_ISSUER=https://sso-example.sso.duosecurity.com/oidc/DIEXAMPLE
DUO_CLIENT_ID=DIEXAMPLE
DUO_CLIENT_SECRET=replace-me
DUO_AUTHORIZATION_URL=
DUO_TOKEN_URL=
DUO_REDIRECT_URI=http://127.0.0.1:3000/auth/duo/callback
DUO_ADMIN_EMAILS=you@example.com
# Production requires at least 32 random bytes.
SESSION_SECRET=replace-with-a-long-random-value

# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
PLAID_WEBHOOK_URL=http://127.0.0.1:3000/webhooks/plaid
# OAuth returns to PUBLIC_BASE_URL/plaid/oauth. Register that exact URL in Plaid.

# MCP
MCP_BEARER_TOKEN=replace-with-a-long-random-value
MCP_PLAN_WRITE_TOKEN=replace-with-a-different-long-random-value
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_CARD_BASE_URL=https://money.example.com

# Optional nightly narrative writer. Facts remain deterministic without it.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=

# Worker
WORKER_POLL_INTERVAL_MS=5000
NIGHTLY_INSIGHTS_HOUR_UTC=9
